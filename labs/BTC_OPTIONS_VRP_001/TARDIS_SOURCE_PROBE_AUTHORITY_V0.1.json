    "access_mode": "free_first_day_of_month_sample_without_api_key",
    "base_url": "https://datasets.tardis.dev/v1",
    "data_types": ["options_chain", "quotes"],
    "aggregate_symbol": "OPTIONS"
  },
  "sample_dates": [
    "2021-06-01",
    "2022-06-01",
    "2023-06-01",
    "2024-06-01"
  ],
  "target_underlying": "BTC",
  "pair_definition": {
    "same_expiry": true,
    "same_strike": true,
    "right_pair": ["C", "P"],
    "dte_min": 25,
    "dte_max": 35,
    "require_nonempty_chain_bbo_both_legs": true,
    "require_nonempty_quote_bbo_both_legs": true
  },
  "bounded_transport": {
    "max_options_chain_rows_per_date": 750000,
    "max_quote_rows_per_date": 2000000,
    "connect_timeout_seconds": 20,
    "read_timeout_seconds": 90
  },
  "pass_rule": {
    "all_dates_http_200": true,
    "all_dates_schema_pass": true,
    "all_dates_btc_option_rows_present": true,
    "all_dates_25_35d_same_strike_call_put_pair_present": true,
    "all_dates_chain_bbo_present_for_selected_pair": true,
    "all_dates_quote_bbo_present_for_selected_pair": true,
    "terminal_pass_classification": "PAID_SOURCE_ROUTE_FEASIBLE"
