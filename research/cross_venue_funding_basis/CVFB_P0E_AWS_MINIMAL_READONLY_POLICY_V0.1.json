{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyReplicaCmds",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::hl-mainnet-node-data"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["replica_cmds", "replica_cmds/*"]
        }
      }
    },
    {
      "Sid": "ReadOnlyReplicaCmdsObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::hl-mainnet-node-data/replica_cmds/*"]
    }
  ]
}
