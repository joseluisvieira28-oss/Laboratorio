          "description": "v3 only: underlying token address.",
          "type": "string"
        },
        "version": {
          "description": "Optional: inferred from the reserve selector ('reserveId' is v4, 'market'+'token'+'chainId' is v3). Send it to be explicit, or if you somehow set both.",
