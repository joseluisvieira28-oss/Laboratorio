  "tool_input_schemas": {
    "get_markets": {
      "additionalProperties": false,
      "properties": {
        "chainId": {
          "description": "Chain id to restrict to, e.g. 1 for Ethereum. Omit the argument entirely to cover every chain.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "symbols": {
          "description": "Optional token symbols to return, e.g. ['USDC','GHO']. Case-insensitive. Strongly preferred when you know the asset: a chain has ~70 reserves and listing them all is a large response.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "user": {
          "description": "Optional wallet address (0x, 40 hex). Adds walletBalance, youCanSupply and youCanBorrow to every row, for this wallet, in the same call. Pass it whenever the question is about what someone can actually do rather than what the rates are.",
          "type": "string"
        },
        "version": {
          "description": "Protocol version (default all).",
          "enum": [
            "v3",
            "v4",
            "all"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "get_position_items": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "description": "Which side to list (default supply).",
          "enum": [
            "supply",
            "borrow"
          ],
          "type": "string"
        },
        "spokeId": {
          "description": "spokeId from get_user_positions (not the spoke address).",
          "type": "string"
        },
        "user": {
          "description": "Wallet address, 0x-prefixed (40 hex chars).",
          "type": "string"
        },
        "version": {
          "description": "Optional, and only 'v4': this tool exists on v4 only.",
          "enum": [
            "v4"
          ],
          "type": "string"
        }
      },
      "required": [
        "user",
        "spokeId"
      ],
      "type": "object"
    },
