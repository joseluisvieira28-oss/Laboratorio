%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":146044608,"digest":null,"download_count":10752,"created_at":"2025-04-14T18:48:22Z","updated_at":"2025-04-14T18:48:29Z","browser_download_url":"https://github.com/CoreumFoundation/coreum/releases/download/v5.0.0/cored-linux-amd64"},{"url":"https://api.github.com/repos/CoreumFoundation/coreum/releases/assets/246352885","id":246352885,"node_id":"RA_kwDOHHsMMc4Orwv1","name":"cored-linux-arm64","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":122346700,"digest":null,"download_count":1022,"created_at":"2025-04-14T18:48:22Z","updated_at":"2025-04-14T18:48:27Z","browser_download_url":"https://github.com/CoreumFoundation/coreum/releases/download/v5.0.0/cored-linux-arm64"}],"tarball_url":"https://api.github.com/repos/CoreumFoundation/coreum/tarball/v5.0.0","zipball_url":"https://api.github.com/repos/CoreumFoundation/coreum/zipball/v5.0.0","body":"## What's Changed\r\n* Add generate-devnet CLI command. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/721\r\n* Introduce `go.work` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/724\r\n* Bump coreum to `v4` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/723\r\n* Provide more info related to `cored` binaries by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/725\r\n* Clean v4 temporary CI fix by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/726\r\n* move cnft register services outside the RegisterAPI function by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/727\r\n* Bump github.com/cosmos/ledger-cosmos-go to v0.12.4 to fix Ledger with CLI by @ysv in https://github.com/CoreumFoundation/coreum/pull/730\r\n* Increase vesting timeouts to fix tests on devnet by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/735\r\n* Add go version to cache ids by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/734\r\n* Add smart contract instantiation test by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/736\r\n* Enable line length linter by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/737\r\n* Change WASM behaviour to default: burn vesting balance when instantiating contract by @ysv in https://github.com/CoreumFoundation/coreum/pull/741\r\n* In determgas/ante charge Fixed before Bonus & improve descriptor text by @ysv in https://github.com/CoreumFoundation/coreum/pull/744\r\n* Emit deterministic gas event by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/745\r\n* Generate genesis file from input config file by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/747\r\n* Add upgrade plans `v3patch1` and `v3patch2` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/749\r\n* Add `v3.0.2` to supported upgrade steps in test by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/751\r\n* Regenerate OpenAPI spec by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/752\r\n* Test upgrade from v3.0.2 by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/750\r\n* Regenerate OpenAPI by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/755\r\n* Add asset ft issuance operation simulation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/748\r\n* Setup Codecov integration in CI by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/753\r\n* Update dependencies due to dependabot alerts by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/754\r\n* Remove `cored-v3.0.0` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/758\r\n* Restore legacy `gov` integration test. by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/759\r\n* Restore test for upgrading `v2` to `v3` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/760\r\n* Make integration-tests stable by @ysv in https://github.com/CoreumFoundation/coreum/pull/761\r\n* Divide authz into 3 contracts by @keyleu in https://github.com/CoreumFoundation/coreum/pull/762\r\n* Replace hardcoded timeout duration to the one from gov params by @ysv in https://github.com/CoreumFoundation/coreum/pull/763\r\n* upgrade wasmvm version by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/766\r\n* In CI reference crust master again by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/767\r\n* Fix v4 TODOs by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/771\r\n* Move `TestMultisigAddressGeneration` to unit tests by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/772\r\n* Increase upgrade delay in blocks & fix hardcoded timeout in legacy gov by @ysv in https://github.com/CoreumFoundation/coreum/pull/769\r\n* added ibc transfer module to open API specs by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/773\r\n* Move building system from `crust` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/757\r\n* Set CI to use local build by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/775\r\n* Stop rejecting contract instantiation if account holds funds by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/776\r\n* Add function to generate unsigned Tx by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/778\r\n* Integrate codecov into integration-tests/modules by @ysv in https://github.com/CoreumFoundation/coreum/pull/777\r\n* Upgrade Cosmos SDK to v0.47.8 by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/779\r\n* Return wrapped SDK context by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/780\r\n* Build system fixes by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/782\r\n* Build missing `cored` image by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/785\r\n* Remove crosscompilation code moved to `crust` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/784\r\n* Bumped cosmos sdk version to v0.47.9 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/786\r\n* Update github actions in CI to v4 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/789\r\n* Allow zero precision for ft tokens by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/787\r\n* Separated build step for tests in CI by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/788\r\n* Use Flags instead of Parameters & Tags and update crust/build by @ysv in https://github.com/CoreumFoundation/coreum/pull/783\r\n* Update GitHub action versions to latest. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/791\r\n* Update `build` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/792\r\n* Add security policy. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/797\r\n* Set more params in genesis generation by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/799\r\n* Add NFT dynamic data proto files. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/794\r\n* Format docs/api.md so it is a valid markdown file by @ysv in https://github.com/CoreumFoundation/coreum/pull/796\r\n* Migrate CI to use `coreum-builder` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/798\r\n* Fix one line of error handling by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/803\r\n* Change order of tests in upgrade test to upgrade -> IBC -> modules by @ysv in https://github.com/CoreumFoundation/coreum/pull/806\r\n* Allow NFT data modification by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/800\r\n* Use correct name for amino MsgSetFrozen. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/808\r\n* Update coreum upgrade binary to v3.0.3. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/809\r\n* Implement Clawback feature for assetft by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/804\r\n* Remove duplication of the `-ldflags` in the builder. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/811\r\n* Upgrade vulnerable dependencies by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/807\r\n* Check the NFT data for nil when updating the dynamic data. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/813\r\n* Implmenet POC version of asset extensions  by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/802\r\n* upgrade-vulnerable-dependencies by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/815\r\n* Integrate IBC hooks by @ysv in https://github.com/CoreumFoundation/coreum/pull/801\r\n* Modify NFT contract to use new protos for updatable NFTs and include examples by @keyleu in https://github.com/CoreumFoundation/coreum/pull/812\r\n* update-docs-for-ft-clawback by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/814\r\n* Add dex module skeleton. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/817\r\n* Replace issuer to admin in docs by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/819\r\n* Separation of issuer and admin for fungible tokens by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/805\r\n* Update docker cache CI action. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/823\r\n* Update crust to latest version by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/824\r\n* Integrate packet-forward-middleware by @ysv in https://github.com/CoreumFoundation/coreum/pull/822\r\n* Introduce Makefile by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/816\r\n* Updated crust and increase tests timeout by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/828\r\n* Implementing features in extension contract by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/818\r\n* Update query handler and separate contracts with legacy bindings and stargate/grpc for transactions by @keyleu in https://github.com/CoreumFoundation/coreum/pull/827\r\n* Improve integration tests gas price and gas adjustments. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/836\r\n* Add more tests for drop FT admin feature by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/829\r\n* Compile required asset smart contract for integration tests by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/833\r\n* Usd DNS for default coreum seeds. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/837\r\n* Use sudo entry point for asset extension invocation by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/832\r\n* Unify gas adjustment usage for the integration tests. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/840\r\n* Update NFT spec with dynamic data. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/831\r\n* Handle burn rate in extensions by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/834\r\n* Remove NFT data limit. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/844\r\n* Update doc by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/838\r\n* Additional integration-test for IBC PFM by @ysv in https://github.com/CoreumFoundation/coreum/pull/847\r\n* Implemented IBC in asset extension by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/841\r\n* Make NFT methods outputs deterministic by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/848\r\n* Add docs for asset extension by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/849\r\n* Fix block smart contract feature in extension by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/846\r\n* Start znet programmatically by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/851\r\n* Integrate ICA IBC. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/852\r\n* Use build/go.sum as a part of docker and crust cache keys by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/860\r\n* Update asset issue cli to allow for extensions by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/855\r\n* Set commit timeout to 0.5s for IBC tests by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/857\r\n* Script downloading cored by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/854\r\n* Use custom fuse gas multiplier for simulation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/861\r\n* Handle IBC edge cases by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/853\r\n* Build `cored` binary and docker image with cometBFT replaced by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/858\r\n* Build local `znet` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/862\r\n* Implemented nondeterministic gas for extensions by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/845\r\n* Add significant_amount/max_execution_quantity matching spec and POC by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/859\r\n* Fix IBC tests to work against devnet or testnet by @ysv in https://github.com/CoreumFoundation/coreum/pull/856\r\n* Disallow IBC and BlockSmartContract in conjunction with extension by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/864\r\n* Specify module path when building by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/868\r\n* Fix cored-ext docker image by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/870\r\n* Fix extension contract bug by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/874\r\n* Update `crust` to latest master by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/879\r\n* Add extension instantiation info by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/871\r\n* Fix typo in asset extension doc by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/878\r\n* Update dependencies by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/877\r\n* Fixed if statement for asset extension exception by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/866\r\n* Allowed attached funds to work with extension token issuance by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/869\r\n* Update cometBFT replacement by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/881\r\n* Run other tests after upgrade by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/883\r\n* Fixed todos in preparation for v5 release by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/884\r\n* block non-core tokens from proposal deposit by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/873\r\n* Fixed the doc regarding extension gas usage by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/875\r\n* Run CI on self-hosted by @alinetskyi in https://github.com/CoreumFoundation/coreum/pull/882\r\n* Release static darwin binaries by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/886\r\n* Removed \"all except one\" test case that fails randomly by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/888\r\n* Add extension gas test by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/876\r\n* Remove stuff not required by CI anymore by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/889\r\n* Set block size to 6MB by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/880\r\n* Updated cosmos sdk dependency to v0.47.12 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/890\r\n* Build local `cored` without `-cover` flag by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/892\r\n* Add 2 sides, 2 ways order matching spec with example.  by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/872\r\n* Describe DEX price tick and precision by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/891\r\n* Update setup instructions by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/894\r\n* Fixed -b block flag when the tx fails in CheckTx phase by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/893\r\n* Upgrade `coreum-wasm-sdk` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/896\r\n* Replace new DEX spec with old and add balance locking description. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/900\r\n* Update setup-client.sh coreum version to v4.0.0 by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/901\r\n* Implement DEX order storing with ordered price represented as num/exponent by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/902\r\n* Implement DEX price type marshalling. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/904\r\n* Add price fuzz tests and integrate fuzz testing framework. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/906\r\n* Fix integration tests with txbytes constants by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/911\r\n* Remove flags from codecov step by @alinetskyi in https://github.com/CoreumFoundation/coreum/pull/914\r\n* DEX orders matching with the self order book. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/910\r\n* Implement coins locking for both ft and native coins. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/913\r\n* Exclude pb files from coverage. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/917\r\n* Use a spendable balance as min(locked, frozen). by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/918\r\n* Add DEX place-order, orders, order-books, order-book-orders CLI by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/916\r\n* Upgrade Cosmos SDK to v0.50.8 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/920\r\n* Point to crust master branch by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/922\r\n* Check locked coins for the clawback. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/919\r\n* Lock/unlock coins in FT when place/execute a DEX order.  by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/921\r\n* Fix proto annotations and remove amino json interface by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/924\r\n* enable back proto breaking by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/925\r\n* Implement opposite-order matching and integrate it to work with the self-order matching. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/923\r\n* Implement DEX order cancellation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/926\r\n* Fix CLI tests after upgrade to cosmos v0.50.x. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/927\r\n* removed old module migrations by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/928\r\n* Implement market order matching by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/929\r\n* Allow any price and quantity for the limit order. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/930\r\n* Implement DEX fuzz test for the orders placement and cancellation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/932\r\n* Integrate the DEX settings creation and update to the assetft. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/934\r\n* backport to master fix for authz deterministic gas(#935) by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/937\r\n* Use module prefix for all modules amino messages. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/936\r\n* Add DEX gov `default_unified_ref_amount` and `price_tick_exponent` params. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/939\r\n* Integrate limit order price tick validation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/940\r\n* Allow gov to update asset FT DEX settings. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/942\r\n* Update DEX spec. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/941\r\n* Update Cosmos SDK to v0.50.9 versions by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/938\r\n* Implement DEX order book and orders import/export. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/943\r\n* removed module basic global var by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/944\r\n* Fix TestLegacyAmino_ExpectedMessages by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/945\r\n* Fix TestDelayedExecution by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/946\r\n* Implement DEX good_til_block_height. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/947\r\n* Fix TestICACoreumController by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/948\r\n* Support ExpeditedVotingPeriod in generate-genesis by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/951\r\n* Implement DEX good til block time. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/949\r\n* Update DEX matching fuzz with good til. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/950\r\n* Add ExpeditedMinDepositAmount to znet by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/954\r\n* Add TimeInForce attribute for the order and integrate GTC type for the matching. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/955\r\n* Add integration test for expedited proposals and cancel proposals by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/953\r\n* Integrate IOC time in force for the DEX orders matching. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/956\r\n* Prohibit to DEX lock tokens with extensions. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/957\r\n* Add block_dex assetft feature and integrate it. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/959\r\n* Fix TestDeterministicGas_DeterministicMessages by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/958\r\n* Add support for textual sign mode by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/960\r\n* remove generate-devnet by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/963\r\n* Integrate max orders per account/denom DEX limit. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/965\r\n* DEX tests with freeze / global freeze by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/966\r\n* Fix cored-ext by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/964\r\n* Upated new governance params related to v0.50 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/962\r\n* Remove genesis templates by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/970\r\n* Added missing proto to OpenAPI by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/967\r\n* Implement DEX cancel orders by denom. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/968\r\n* Feature: Introduce CI concurrency to only run CI pipeline on the late… by @alinetskyi in https://github.com/CoreumFoundation/coreum/pull/973\r\n* Handle Clawback with Dex combo by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/972\r\n* Clean up initParamsKeeper function by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/971\r\n* Test dex with features by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/974\r\n* Add asset FT dex_whitelisted_denoms feature and integrate it with DEX. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/961\r\n* Update DEX matching test with cancel orders by denom. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/975\r\n* Update matching to apply the changes after the matching. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/978\r\n* fixed auto gas prices in cli by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/976\r\n* Add cli option for Good Til to dex by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/977\r\n* Fix metrics to have gas estimation metrics by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/982\r\n* Add FOK time in force. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/979\r\n* Add unit and integration test for burn rate and send commission rate … by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/984\r\n* Integrate DEX order cancellation feature. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/983\r\n* Lock min required balance for GTC orders. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/981\r\n* bump coreum version v5 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/987\r\n* point to crust master by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/988\r\n* Fix gas usage for specific messages by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/985\r\n* enable TestAutoGasPrices test by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/986\r\n* Integrate DEX whitelisting checks. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/989\r\n* Add DEX order reserve gov param. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/992\r\n* Integrate FT whitelisting and freezing to the DEX fuzz test by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/990\r\n* Integrate DEX order reserve. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/995\r\n* DEX order reserve fuzz by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/997\r\n* Add time-in-force & fix some cli params by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/993\r\n* Add more CLI methods to DEX and FT by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/994\r\n* Add DEX test with IBC by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/996\r\n* Allow to update DEX unified ref amount by token admin. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/998\r\n* Upgrade contracts to cosmwasm 2.1.4 by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/991\r\n* DEX orders events by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/999\r\n* Update default price tick exponent. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1001\r\n* DEX genesis validation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1000\r\n* added missing ibc-hooks module to the export list by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1003\r\n* Add unified ref amount change to DEX matching fuzz. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1006\r\n* Refactor DEX price type validation and update spec with more description. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1005\r\n* added test for app export by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1007\r\n* Integrate whitelisted denoms update to DEX matching fuzz test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1010\r\n* Add stress test for DEX orders by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1009\r\n* Add timeout to CI jobs by @alinetskyi in https://github.com/CoreumFoundation/coreum/pull/1011\r\n* Test DEX messages and queries in wasm by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1012\r\n* DEX whitelist test by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1016\r\n* Integrate vesting accounts to the DEX fuzz test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1014\r\n* Update DEX related deterministic messages gas and make the MsgPlaceOrder nondeterministic. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1013\r\n* Block DEX for tokens with `block_smart_contracts` feature calling from the smart contracts. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1015\r\n* Update spec with locking/freezing/whitelisting/clawback. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1017\r\n* Add IBC demon metadata transfer integration test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1019\r\n* enabled optimistic execution by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1018\r\n* Decrease the gas required for the module's integration tests to pass. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1020\r\n* Add DEX with asset FT burning integration test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1021\r\n* Don't allow to place DEX order if base or quote denom has global freeze enabled. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1022\r\n* Update `DEX whitelisting reserved` to `DEX expected to receive`. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1023\r\n* Refactor integration of asset FT with the DEX to accept all `DEXActions` by asset FT required to be applied. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1025\r\n* Integrate order sequence into new DEX events and order queries. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1027\r\n* updated go version 1.23.3 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1026\r\n* Update DEX WASM tests to work with the update version of the WASM SDK. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1030\r\n* Use KVStoreService instead of StoreKey by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1028\r\n* Integrate asset FT extensions with the DEX. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1029\r\n* Integrate DEX-related asset FT queries and messages for the WASM. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1031\r\n* Update extensions integration to check asset FT rules before calling the extensions. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1033\r\n* Fix coreum update integration tests for darwin. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1036\r\n* Update crust to latest. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1038\r\n* Integrate asset FT extensions into the DEX matching fuzz test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1035\r\n* Implement concurrent safe WASM GRPC query handler. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1034\r\n* Asset FT + DEX migration by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1040\r\n* upgraded math dependencies by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1032\r\n* update hermes to v10.1.4 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1041\r\n* Add order sequence to DEX extension call. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1044\r\n* Update asset FT and DEX docs with the extension. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1045\r\n* Remove lock/mutex from GRPC WASM querier. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1043\r\n* updated cosmovisor to 1.6 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1046\r\n* Update price tick examples in DEX spec. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1051\r\n* Improve DEX place-order CLI by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1050\r\n* Improve DEX spec. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1053\r\n* update readme for initial setup instructions by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1049\r\n* changed default network configs in init command by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1058\r\n* Update crust with the callisto by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1056\r\n* Merge smart contract test cargo files by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1059\r\n* Update crust to the latest. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1060\r\n* Update crust to latest with single hermes relayer. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1061\r\n* Improve comments and var names. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1062\r\n* x/dex fix typos in  & minor improvements by @ysv in https://github.com/CoreumFoundation/coreum/pull/1064\r\n* Use the newer version of builder which extracts non-essential tools by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1063\r\n* Add unsigned tx simulation option by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1066\r\n* rename opposite to inverted for DEX orderbook & other minor naming fixes by @ysv in https://github.com/CoreumFoundation/coreum/pull/1069\r\n* respect OrderSequence FIFO when price in direct & inverted OB is the same by @ysv in https://github.com/CoreumFoundation/coreum/pull/1071\r\n* Update dependencies by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1072\r\n* order matching refactoring & critical fixes by @ysv in https://github.com/CoreumFoundation/coreum/pull/1074\r\n* updated iavl version to 1.2.4 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1076\r\n* use TIME_IN_FORCE_IOC instead of TIME_IN_FORCE_UNSPECIFIED for market orders by @ysv in https://github.com/CoreumFoundation/coreum/pull/1075\r\n* removed extended cored build code by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1078\r\n* rename remaining_quantity->remaining_base_quantity & remaining_spendable_balance by @ysv in https://github.com/CoreumFoundation/coreum/pull/1079\r\n* updated dependecies to address ASA-2025-002 and CWA-2025-002 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1077\r\n* upgrade asset ft feature update_unified_ref_amount by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1081\r\n* Fix flaky test TestIBCCallFromSmartContract by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1082\r\n* migrated mint params for blocks_per_year and inflation by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1083\r\n* Retry once if the address is already in use by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1085\r\n* Update znet dependency by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1086\r\n* Add CI cache by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1080\r\n* Document formulas & math & research for price_tick_size & base_amount_step   by @ysv in https://github.com/CoreumFoundation/coreum/pull/1084\r\n* Deleted unused functions by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1089\r\n* Fix znet by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1090\r\n* added extra validation to assetft genesis by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1092\r\n* added legacy amino support for missed messages in assetft by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1093\r\n* added underflow check to decrement fucntion by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1096\r\n* adjust & refactor DEX price_tick formula by @ysv in https://github.com/CoreumFoundation/coreum/pull/1094\r\n* Update dependencies to fix security vulnerabilities by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1091\r\n* allow upgrade paths to be passed to znet.Main by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1097\r\n* uncomment proto compatibility check in lint by @ysv in https://github.com/CoreumFoundation/coreum/pull/1088\r\n* fixed a typo in an error message by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1098\r\n* Fix coreum-builder bash script by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1100\r\n* Remove TODOs and FIXMEs by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1102\r\n* Drop govv1beta1 support by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1101\r\n* Move OrderBookRecord to types by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1103\r\n* fixed some error handling in the dex module by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1106\r\n* Enable EnumAsString by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1105\r\n* Integrate quantity_step into DEX matching by @ysv in https://github.com/CoreumFoundation/coreum/pull/1099\r\n* Price tick and quantity step query by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1107\r\n* Update crust and znet, fix for monitoring failure by @TxCorpi0x in https://github.com/CoreumFoundation/coreum/pull/1114\r\n* Add validation to OrderBookParams query by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1118\r\n* Add CLI to query OrderBookParams by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1111\r\n* Check if feature is already enabled before enabling it in token upgrade by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1113\r\n* Make order id globally unique for each address by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1104\r\n* Validate that both base & quote denom exist on order creation by @ysv in https://github.com/CoreumFoundation/coreum/pull/1110\r\n* Fix GetFrozenBalance wrong report for admin by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1115\r\n* Fix reentrancy issue by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1109\r\n* Fix IssueFee burn without checking if it is locked by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1112\r\n* Fixes NewPrice invalid check, and uses cosmos error wrap instead of pkg/error by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1121\r\n* fixed the problem in cli with too big initial amount by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1119\r\n* removed inflation change in upgrade v5 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1123\r\n* limit unified ref amount to 10^50 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1127\r\n* bring back proto breaking check by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1122\r\n* Upgrade coreum-wasm-sdk by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1126\r\n\r\n## New Contributors\r\n* @TxCorpi0x made their first contribution in https://github.com/CoreumFoundation/coreum/pull/1114\r\n\r\n**Full Changelog**: https://github.com/CoreumFoundation/coreum/compare/v3.0.0...v5.0.0\r\n\r\n## What's Changed\r\n* Replace new DEX spec with old and add balance locking description. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/900\r\n* Update setup-client.sh coreum version to v4.0.0 by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/901\r\n* Implement DEX order storing with ordered price represented as num/exponent by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/902\r\n* Implement DEX price type marshalling. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/904\r\n* Add price fuzz tests and integrate fuzz testing framework. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/906\r\n* Fix integration tests with txbytes constants by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/911\r\n* Remove flags from codecov step by @alinetskyi in https://github.com/CoreumFoundation/coreum/pull/914\r\n* DEX orders matching with the self order book. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/910\r\n* Implement coins locking for both ft and native coins. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/913\r\n* Exclude pb files from coverage. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/917\r\n* Use a spendable balance as min(locked, frozen). by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/918\r\n* Add DEX place-order, orders, order-books, order-book-orders CLI by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/916\r\n* Upgrade Cosmos SDK to v0.50.8 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/920\r\n* Point to crust master branch by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/922\r\n* Check locked coins for the clawback. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/919\r\n* Lock/unlock coins in FT when place/execute a DEX order.  by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/921\r\n* Fix proto annotations and remove amino json interface by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/924\r\n* enable back proto breaking by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/925\r\n* Implement opposite-order matching and integrate it to work with the self-order matching. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/923\r\n* Implement DEX order cancellation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/926\r\n* Fix CLI tests after upgrade to cosmos v0.50.x. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/927\r\n* removed old module migrations by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/928\r\n* Implement market order matching by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/929\r\n* Allow any price and quantity for the limit order. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/930\r\n* Implement DEX fuzz test for the orders placement and cancellation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/932\r\n* Integrate the DEX settings creation and update to the assetft. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/934\r\n* backport to master fix for authz deterministic gas(#935) by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/937\r\n* Use module prefix for all modules amino messages. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/936\r\n* Add DEX gov `default_unified_ref_amount` and `price_tick_exponent` params. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/939\r\n* Integrate limit order price tick validation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/940\r\n* Allow gov to update asset FT DEX settings. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/942\r\n* Update DEX spec. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/941\r\n* Update Cosmos SDK to v0.50.9 versions by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/938\r\n* Implement DEX order book and orders import/export. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/943\r\n* removed module basic global var by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/944\r\n* Fix TestLegacyAmino_ExpectedMessages by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/945\r\n* Fix TestDelayedExecution by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/946\r\n* Implement DEX good_til_block_height. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/947\r\n* Fix TestICACoreumController by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/948\r\n* Support ExpeditedVotingPeriod in generate-genesis by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/951\r\n* Implement DEX good til block time. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/949\r\n* Update DEX matching fuzz with good til. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/950\r\n* Add ExpeditedMinDepositAmount to znet by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/954\r\n* Add TimeInForce attribute for the order and integrate GTC type for the matching. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/955\r\n* Add integration test for expedited proposals and cancel proposals by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/953\r\n* Integrate IOC time in force for the DEX orders matching. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/956\r\n* Prohibit to DEX lock tokens with extensions. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/957\r\n* Add block_dex assetft feature and integrate it. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/959\r\n* Fix TestDeterministicGas_DeterministicMessages by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/958\r\n* Add support for textual sign mode by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/960\r\n* remove generate-devnet by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/963\r\n* Integrate max orders per account/denom DEX limit. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/965\r\n* DEX tests with freeze / global freeze by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/966\r\n* Fix cored-ext by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/964\r\n* Upated new governance params related to v0.50 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/962\r\n* Remove genesis templates by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/970\r\n* Added missing proto to OpenAPI by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/967\r\n* Implement DEX cancel orders by denom. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/968\r\n* Feature: Introduce CI concurrency to only run CI pipeline on the late… by @alinetskyi in https://github.com/CoreumFoundation/coreum/pull/973\r\n* Handle Clawback with Dex combo by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/972\r\n* Clean up initParamsKeeper function by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/971\r\n* Test dex with features by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/974\r\n* Add asset FT dex_whitelisted_denoms feature and integrate it with DEX. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/961\r\n* Update DEX matching test with cancel orders by denom. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/975\r\n* Update matching to apply the changes after the matching. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/978\r\n* fixed auto gas prices in cli by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/976\r\n* Add cli option for Good Til to dex by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/977\r\n* Fix metrics to have gas estimation metrics by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/982\r\n* Add FOK time in force. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/979\r\n* Add unit and integration test for burn rate and send commission rate … by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/984\r\n* Integrate DEX order cancellation feature. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/983\r\n* Lock min required balance for GTC orders. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/981\r\n* bump coreum version v5 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/987\r\n* point to crust master by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/988\r\n* Fix gas usage for specific messages by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/985\r\n* enable TestAutoGasPrices test by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/986\r\n* Integrate DEX whitelisting checks. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/989\r\n* Add DEX order reserve gov param. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/992\r\n* Integrate FT whitelisting and freezing to the DEX fuzz test by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/990\r\n* Integrate DEX order reserve. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/995\r\n* DEX order reserve fuzz by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/997\r\n* Add time-in-force & fix some cli params by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/993\r\n* Add more CLI methods to DEX and FT by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/994\r\n* Add DEX test with IBC by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/996\r\n* Allow to update DEX unified ref amount by token admin. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/998\r\n* Upgrade contracts to cosmwasm 2.1.4 by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/991\r\n* DEX orders events by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/999\r\n* Update default price tick exponent. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1001\r\n* DEX genesis validation. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1000\r\n* added missing ibc-hooks module to the export list by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1003\r\n* Add unified ref amount change to DEX matching fuzz. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1006\r\n* Refactor DEX price type validation and update spec with more description. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1005\r\n* added test for app export by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1007\r\n* Integrate whitelisted denoms update to DEX matching fuzz test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1010\r\n* Add stress test for DEX orders by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1009\r\n* Add timeout to CI jobs by @alinetskyi in https://github.com/CoreumFoundation/coreum/pull/1011\r\n* Test DEX messages and queries in wasm by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1012\r\n* DEX whitelist test by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1016\r\n* Integrate vesting accounts to the DEX fuzz test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1014\r\n* Update DEX related deterministic messages gas and make the MsgPlaceOrder nondeterministic. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1013\r\n* Block DEX for tokens with `block_smart_contracts` feature calling from the smart contracts. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1015\r\n* Update spec with locking/freezing/whitelisting/clawback. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1017\r\n* Add IBC demon metadata transfer integration test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1019\r\n* enabled optimistic execution by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1018\r\n* Decrease the gas required for the module's integration tests to pass. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1020\r\n* Add DEX with asset FT burning integration test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1021\r\n* Don't allow to place DEX order if base or quote denom has global freeze enabled. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1022\r\n* Update `DEX whitelisting reserved` to `DEX expected to receive`. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1023\r\n* Refactor integration of asset FT with the DEX to accept all `DEXActions` by asset FT required to be applied. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1025\r\n* Integrate order sequence into new DEX events and order queries. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1027\r\n* updated go version 1.23.3 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1026\r\n* Update DEX WASM tests to work with the update version of the WASM SDK. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1030\r\n* Use KVStoreService instead of StoreKey by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1028\r\n* Integrate asset FT extensions with the DEX. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1029\r\n* Integrate DEX-related asset FT queries and messages for the WASM. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1031\r\n* Update extensions integration to check asset FT rules before calling the extensions. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1033\r\n* Fix coreum update integration tests for darwin. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1036\r\n* Update crust to latest. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1038\r\n* Integrate asset FT extensions into the DEX matching fuzz test. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1035\r\n* Implement concurrent safe WASM GRPC query handler. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1034\r\n* Asset FT + DEX migration by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1040\r\n* upgraded math dependencies by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1032\r\n* update hermes to v10.1.4 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1041\r\n* Add order sequence to DEX extension call. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1044\r\n* Update asset FT and DEX docs with the extension. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1045\r\n* Remove lock/mutex from GRPC WASM querier. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1043\r\n* updated cosmovisor to 1.6 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1046\r\n* Update price tick examples in DEX spec. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1051\r\n* Improve DEX place-order CLI by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1050\r\n* Improve DEX spec. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1053\r\n* update readme for initial setup instructions by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1049\r\n* changed default network configs in init command by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1058\r\n* Update crust with the callisto by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1056\r\n* Merge smart contract test cargo files by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1059\r\n* Update crust to the latest. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1060\r\n* Update crust to latest with single hermes relayer. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1061\r\n* Improve comments and var names. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/1062\r\n* x/dex fix typos in  & minor improvements by @ysv in https://github.com/CoreumFoundation/coreum/pull/1064\r\n* Use the newer version of builder which extracts non-essential tools by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1063\r\n* Add unsigned tx simulation option by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1066\r\n* rename opposite to inverted for DEX orderbook & other minor naming fixes by @ysv in https://github.com/CoreumFoundation/coreum/pull/1069\r\n* respect OrderSequence FIFO when price in direct & inverted OB is the same by @ysv in https://github.com/CoreumFoundation/coreum/pull/1071\r\n* Update dependencies by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1072\r\n* order matching refactoring & critical fixes by @ysv in https://github.com/CoreumFoundation/coreum/pull/1074\r\n* updated iavl version to 1.2.4 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1076\r\n* use TIME_IN_FORCE_IOC instead of TIME_IN_FORCE_UNSPECIFIED for market orders by @ysv in https://github.com/CoreumFoundation/coreum/pull/1075\r\n* removed extended cored build code by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1078\r\n* rename remaining_quantity->remaining_base_quantity & remaining_spendable_balance by @ysv in https://github.com/CoreumFoundation/coreum/pull/1079\r\n* updated dependecies to address ASA-2025-002 and CWA-2025-002 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1077\r\n* upgrade asset ft feature update_unified_ref_amount by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1081\r\n* Fix flaky test TestIBCCallFromSmartContract by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1082\r\n* migrated mint params for blocks_per_year and inflation by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1083\r\n* Retry once if the address is already in use by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1085\r\n* Update znet dependency by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1086\r\n* Add CI cache by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1080\r\n* Document formulas & math & research for price_tick_size & base_amount_step   by @ysv in https://github.com/CoreumFoundation/coreum/pull/1084\r\n* Deleted unused functions by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1089\r\n* Fix znet by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1090\r\n* added extra validation to assetft genesis by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1092\r\n* added legacy amino support for missed messages in assetft by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1093\r\n* added underflow check to decrement fucntion by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1096\r\n* adjust & refactor DEX price_tick formula by @ysv in https://github.com/CoreumFoundation/coreum/pull/1094\r\n* Update dependencies to fix security vulnerabilities by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1091\r\n* allow upgrade paths to be passed to znet.Main by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1097\r\n* uncomment proto compatibility check in lint by @ysv in https://github.com/CoreumFoundation/coreum/pull/1088\r\n* fixed a typo in an error message by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1098\r\n* Fix coreum-builder bash script by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1100\r\n* Remove TODOs and FIXMEs by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1102\r\n* Drop govv1beta1 support by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1101\r\n* Move OrderBookRecord to types by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1103\r\n* fixed some error handling in the dex module by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1106\r\n* Enable EnumAsString by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1105\r\n* Integrate quantity_step into DEX matching by @ysv in https://github.com/CoreumFoundation/coreum/pull/1099\r\n* Price tick and quantity step query by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1107\r\n* Update crust and znet, fix for monitoring failure by @TxCorpi0x in https://github.com/CoreumFoundation/coreum/pull/1114\r\n* Add validation to OrderBookParams query by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1118\r\n* Add CLI to query OrderBookParams by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1111\r\n* Check if feature is already enabled before enabling it in token upgrade by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1113\r\n* Make order id globally unique for each address by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1104\r\n* Validate that both base & quote denom exist on order creation by @ysv in https://github.com/CoreumFoundation/coreum/pull/1110\r\n* Fix GetFrozenBalance wrong report for admin by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1115\r\n* Fix reentrancy issue by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1109\r\n* Fix IssueFee burn without checking if it is locked by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1112\r\n* Fixes NewPrice invalid check, and uses cosmos error wrap instead of pkg/error by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1121\r\n* fixed the problem in cli with too big initial amount by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1119\r\n* removed inflation change in upgrade v5 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1123\r\n* limit unified ref amount to 10^50 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1127\r\n* bring back proto breaking check by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/1122\r\n* Upgrade coreum-wasm-sdk by @masihyeganeh in https://github.com/CoreumFoundation/coreum/pull/1126\r\n\r\n## New Contributors\r\n* @TxCorpi0x made their first contribution in https://github.com/CoreumFoundation/coreum/pull/1114\r\n\r\n**Full Changelog**: https://github.com/CoreumFoundation/coreum/compare/v4.1.2...v5.0.0","mentions_count":8},{"url":"https://api.github.com/repos/CoreumFoundation/coreum/releases/192669195","assets_url":"https://api.github.com/repos/CoreumFoundation/coreum/releases/192669195/assets","upload_url":"https://uploads.github.com/repos/CoreumFoundation/coreum/releases/192669195/assets{?name,label}","html_url":"https://github.com/CoreumFoundation/coreum/releases/tag/v4.1.2","id":192669195,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/user