tions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":63940944,"digest":null,"download_count":9,"created_at":"2023-03-14T21:12:00Z","updated_at":"2023-03-14T21:12:03Z","browser_download_url":"https://github.com/CoreumFoundation/coreum/releases/download/v1.0.0-rc1/cored-linux-amd64"},{"url":"https://api.github.com/repos/CoreumFoundation/coreum/releases/assets/99400604","id":99400604,"node_id":"RA_kwDOHHsMMc4F7Luc","name":"cored-linux-arm64","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":59958368,"digest":null,"download_count":8,"created_at":"2023-03-14T21:12:00Z","updated_at":"2023-03-14T21:12:03Z","browser_download_url":"https://github.com/CoreumFoundation/coreum/releases/download/v1.0.0-rc1/cored-linux-arm64"}],"tarball_url":"https://api.github.com/repos/CoreumFoundation/coreum/tarball/v1.0.0-rc1","zipball_url":"https://api.github.com/repos/CoreumFoundation/coreum/zipball/v1.0.0-rc1","body":"## What's Changed\n* Revert NFT cleanup. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/357\n* Prohibit to freeze and whitelist of the FT on the issuer account. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/353\n* Add an invariant to test the frozen and whitelisted balances with the corresponding disabled feature. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/356\n* implemented nft freezing by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/347\n* Add test to verify testnet genesis hash. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/359\n* Apply linter config changes by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/365\n* added docs to describe asset ft behavior by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/351\n* Move deterministic gas config to `x/deterministicgas` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/361\n* Add protobuf breaking change check. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/366\n* Finalized `pkg/client`, extracted config by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/369\n* Integrate WASM handlers for the asset ft module. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/349\n* Integrate vesting module. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/360\n* Update CI repos flat to test-groups. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/371\n* Add unknown message metric. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/368\n* Update deterministic gas table doc by @ysv in https://github.com/CoreumFoundation/coreum/pull/375\n* implemented NFT whitelisting by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/364\n* added disable sending and royalty rate by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/367\n* GRPC client for the client package. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/378\n* Update devnet config to be deployd by new flow. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/384\n* Test if there are any new, unknown proposals used by `cored` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/376\n* Remove deprecated REST proposal handlers by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/374\n* Make `MsgSubmitProposal` a nondeterministic message by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/377\n* Wait for one block in gas_price_test by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/382\n* Update devnet seeds. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/385\n* Use testnet prefixes in the CLI examples. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/383\n* Added more test cases for fungible token by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/381\n* validate token metadata before registering on the bank module by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/379\n* Added validate precision and subunit by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/380\n* added chain-id flag to integration tests by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/391\n* fix readme by @pgoos in https://github.com/CoreumFoundation/coreum/pull/386\n* Integrate IBC modules by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/387\n* Set default min gas price to 0.00000000000000001chain-denom. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/388\n* Remove not needed TODOs and FIXMEs by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/392\n* Use grpc only for the integration tests. by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/390\n* added validation for max block gas by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/397\n* Fixed validator key extraction in app export by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/395\n* register asset ft and nft message types in RegisterImplementations by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/396\n* Run CI workflow using self-hosted runner & minor CI hotfixes by @ysv in https://github.com/CoreumFoundation/coreum/pull/402\n* Remove responses from ignored message types in test by @ysv in https://github.com/CoreumFoundation/coreum/pull/394\n* added overhead in gasprice query in cli by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/401\n* Don't require fee for simulation by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/403\n* Undeterministic -> nondeterministic by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/400\n* extend nft whitelist integration test by @pgoos in https://github.com/CoreumFoundation/coreum/pull/398\n* Create ante decorator blocking defined messages by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/399\n* Run CI using self-hosted runners by @ysv in https://github.com/CoreumFoundation/coreum/pull/404\n* Disable faucet & coreum-upgrade integration-tests in CI by @ysv in https://github.com/CoreumFoundation/coreum/pull/410\n* Fixes required by simulator by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/408\n* Upgrade cosmos sdk to v0.45.14 by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/407\n* fix validation for min_self_deletation by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/406\n* added nft invariants by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/405\n* Enable & partially configure coreum-mainnet-1 network by @ysv in https://github.com/CoreumFoundation/coreum/pull/409\n* Give priority to GRPC client inside `Invoke` by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/422\n* Make the query path for whitelisted account more RESTful by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/415\n* Fix randomly failing test by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/421\n* Adjust sequence of methods in keepers of FT and NFT by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/417\n* Add params queries to NFT and FT by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/413\n* Remove IBC integration by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/420\n* changed prompt printed as description of cored CLI by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/424\n* Replace `cnft` with `nft` in CLI by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/427\n* Return error if fee contains more than one denom by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/419\n* Added ibc to preserved words in subunit validation by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/423\n* Restore CI to its original form by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/426\n* Complex ft integration tests (phase 2) by @pgoos in https://github.com/CoreumFoundation/coreum/pull/418\n* Wait for one more block in upgrade test by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/431\n* removed todos for feemodel params by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/432\n* NFT issuer does not need whitelisting by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/414\n* Wasm asset NFT / native NFT integration by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/428\n* added complex integration tests for NFTs by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/425\n* Implemented complex integration tests phase 4 by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/416\n* fixed some typos in the comments by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/430\n* fixed typos in wstaking error messages by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/433\n* Added docs to the NFT module by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/412\n* Burnt NFT IDs cannot be reused by @wojtek-coreum in https://github.com/CoreumFoundation/coreum/pull/429\n* added more validation to asset ft genesis by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/434\n* fixed asset ft keeper test to use correct address prefix by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/435\n* check there are no duplicate accounts in funded accounts list by @miladz68 in https://github.com/CoreumFoundation/coreum/pull/436\n* Update chains config by @dzmitryhil in https://github.com/CoreumFoundation/coreum/pull/437\n* Finalize mainnet network integration by @ysv in https://github.com/CoreumFoundation/coreum/pull/438\n\n## New Contributors\n* @pgoos made their first contribution in https://github.com/CoreumFoundation/coreum/pull/386\n\n**Full Changelog**: https://github.com/CoreumFoundation/coreum/compare/v0.1.1...v1.0.0-rc1","mentions_count":5},{"url":"https://api.github.com/repos/CoreumFoundation/coreum/releases/90422920","assets_url":"https://api.github.com/repos/CoreumFoundation/coreum/releases/90422920/assets","upload_url":"https://uploads.github.com/repos/CoreumFoundation/coreum/releases/90422920/assets{?name,label}","html_url":"https://github.com/CoreumFoundation/coreum/releases/tag/v0.1.1","id":90422920,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","foll