cation/octet-stream","state":"uploaded","size":24962408,"digest":null,"download_count":48,"created_at":"2021-08-18T16:45:05Z","updated_at":"2021-08-18T16:46:25Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.2.0-beta1/secretnetwork_1.2.0-beta1-8-gbe1ca55e_amd64.deb"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/42638660","id":42638660,"node_id":"MDEyOlJlbGVhc2VBc3NldDQyNjM4NjYw","name":"supernova-1-genesis.json","label":null,"uploader":{"login":"Cashmaney","id":16579705,"node_id":"MDQ6VXNlcjE2NTc5NzA1","avatar_url":"https://avatars.githubusercontent.com/u/16579705?v=4","gravatar_id":"","url":"https://api.github.com/users/Cashmaney","html_url":"https://github.com/Cashmaney","followers_url":"https://api.github.com/users/Cashmaney/followers","following_url":"https://api.github.com/users/Cashmaney/following{/other_user}","gists_url":"https://api.github.com/users/Cashmaney/gists{/gist_id}","starred_url":"https://api.github.com/users/Cashmaney/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cashmaney/subscriptions","organizations_url":"https://api.github.com/users/Cashmaney/orgs","repos_url":"https://api.github.com/users/Cashmaney/repos","events_url":"https://api.github.com/users/Cashmaney/events{/privacy}","received_events_url":"https://api.github.com/users/Cashmaney/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":18841,"digest":null,"download_count":27,"created_at":"2021-08-17T12:14:55Z","updated_at":"2021-08-17T12:14:56Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.2.0-beta1/supernova-1-genesis.json"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.2.0-beta1","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.2.0-beta1","body":"Version 1.2.0-beta1 has been released - Supernova upgrade testnet v1!\r\n\r\n## Highlights\r\n\r\n* Upgraded to Cosmos SDK 0.43. Full changelog can be found [here](https://github.com/cosmos/cosmos-sdk/blob/v0.43.0/CHANGELOG.md)\r\n\r\n* Gas prices are lower - as a result of performance upgrades and optimizations, gas amounts required will be much lower. We will be monitoring these metrics during the testnet period, so the numbers may not be final\r\n* GRPC for cosmos-sdk modules in addition to legacy REST API. See API [here](http://bootstrap.supernova.enigma.co/swagger/)\r\n\r\n* New modules:\r\n\r\n    * [Fee Grant](https://docs.cosmos.network/master/modules/feegrant/) - allows an address to give an allowance to another address\r\n    * [Upgrade](https://docs.cosmos.network/master/modules/upgrade/) - Allows triggering of network-wide software upgrades, which significantly reduces the amount of coordination effort hard-forks require\r\n\r\n* Auto Registration - The new node registering process is now automated via a new command `secretd auto-register`\r\n\r\nSee the full change log [here](https://github.com/enigmampc/SecretNetwork/blob/stargate/CHANGELOG.md)\r\n\r\n## Connecting to the network\r\n\r\nExplorer:  https://secretnodes.com/secret/chains/supernova-1\r\n\r\nFaucet: https://faucet.supernova.enigma.co\r\nchain-id: supernova-1\r\n\r\nBootstrap nodes:\r\n* 115aa0a629f5d70dd1d464bc7e42799e00f4edae@bootstrap.supernova.enigma.co:26656\r\n* ab6394e953e0b570bb1deeb5a8b387aa0dc6188a@node1.supernova.enigma.co:26656\r\n* f3cbc914ec36e3b6a8274d8af349d4633a18d77e@node2.supernova.enigma.co:26656\r\n\r\nDocker Image Name:\r\n* `enigmampc/secret-network-node:v1.2.0-beta1-2-gbe1ca55e-testnet`\r\n\r\nRegistration service (for docker image or auto registration):\r\n* `register.supernova.enigma.co:36667`\r\n\r\n## Docs\r\n\r\nhttps://github.com/enigmampc/SecretNetwork/tree/stargate/docs/testnet/supernova-1\r\n"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/35361357","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/35361357/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/35361357/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.0.4","id":35361357,"author":{"login":"assafmo","id":22766533,"node_id":"MDQ6VXNlcjIyNzY2NTMz","avatar_url":"https://avatars.githubusercontent.com/u/22766533?v=4","gravatar_id":"","url":"https://api.github.com/users/assafmo","html_url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.github.com/users/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/assafmo/subscriptions","organizations_url":"https://api.github.com/users/assafmo/orgs","repos_url":"https://api.github.com/users/assafmo/repos","events_url":"https://api.github.com/users/assafmo/events{/privacy}","received_events_url":"https://api.github.com/users/assafmo/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"MDc6UmVsZWFzZTM1MzYxMzU3","tag_name":"v1.0.4","target_commitish":"master","name":"Mainnet secret-2 v1.0.4 (Ferenginar)","draft":false,"immutable":false,"prerelease":false,"created_at":"2020-12-16T12:22:22Z","updated_at":"2020-12-17T16:55:05Z","published_at":"2020-12-16T15:42:50Z","assets":[{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/29652347","id":29652347,"node_id":"MDEyOlJlbGVhc2VBc3NldDI5NjUyMzQ3","name":"genesis.json","label":null,"uploader":{"login":"assafmo","id":22766533,"node_id":"MDQ6VXNlcjIyNzY2NTMz","avatar_url":"https://avatars.githubusercontent.com/u/22766533?v=4","gravatar_id":"","url":"https://api.github.com/users/assafmo","html_url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.g