308fb990fbc53b57@node2.supernova.enigma.co:26656\r\n\r\nREST port: 1317\r\nRPC port: 26657\r\n\r\nDocker Image Name: TBD\r\n\r\nRegistration service (for docker image or auto registration):\r\n* `register.supernova.enigma.co:36667`\r\n\r\n<!--\r\n## Docs\r\n\r\nhttps://github.com/enigmampc/SecretNetwork/tree/stargate/docs/testnet/supernova-2\r\n-->"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/50832140","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/50832140/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/50832140/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.0.6","id":50832140,"author":{"login":"assafmo","id":22766533,"node_id":"MDQ6VXNlcjIyNzY2NTMz","avatar_url":"https://avatars.githubusercontent.com/u/22766533?v=4","gravatar_id":"","url":"https://api.github.com/users/assafmo","html_url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.github.com/users/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/assafmo/subscriptions","organizations_url":"https://api.github.com/users/assafmo/orgs","repos_url":"https://api.github.com/users/assafmo/repos","events_url":"https://api.github.com/users/assafmo/events{/privacy}","received_events_url":"https://api.github.com/users/assafmo/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDODh_DHs4DB6MM","tag_name":"v1.0.6","target_commitish":"master","name":"Mainnet secret-3 v1.0.6","draft":false,"immutable":false,"prerelease":false,"created_at":"2021-10-05T17:02:03Z","updated_at":"2021-10-13T19:03:09Z","published_at":"2021-10-05T17:16:19Z","assets":[{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/rel