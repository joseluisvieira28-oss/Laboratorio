<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><script type="c8b74da5e086f062b2a04c4f-text/javascript">
      (() => {
        const KEY = "theme";
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const readPref = () => {
          try {
            const v = localStorage.getItem(KEY);
            return v === "dark" || v === "light" || v === "system" ? v : "system";
          } catch {
            return "system";
          }
        };

        const resolveMode = () => {
          const pref = readPref();
          if (pref === "system") return media.matches ? "dark" : "light";
          return pref;
        };

        const applyTheme = () => {
          const root = document.documentElement;
          const pref = readPref();
          const mode = resolveMode();
          if (mode === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          root.setAttribute("data-theme", pref);
          root.style.colorScheme = mode;
          document.querySelectorAll("[data-nb-theme-toggle]").forEach((b) => {
            b.setAttribute("data-nb-state", mode);
            b.setAttribute("data-nb-pref", pref);
          });
        };

        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        media.addEventListener("change", () => {
          if (!readPref()) applyTheme();
        });
        window.addEventListener("storage", (e) => {
          if (e.key === KEY) applyTheme();
        });

        window.__nbApplyTheme = applyTheme;
      })();
    </script><title>Quick Setup | Secret Network</title><meta name="generator" content="Astro v7.3.1"><meta name="description" content="Run secret-setup.py to install secretd 1.27.2, register the node, and restore the secret-4 snapshot."><link rel="icon" type="image/x-icon" href="/favicon.ico"><link rel="stylesheet" href="/_nimbus/shiki.css"><link rel="canonical" href="https://docs.scrt.network/"><link rel="sitemap" href="/sitemap-index.xml"><link rel="alternate" type="text/markdown" href="https://docs.scrt.network/index.md"><link rel="alternate" type="text/plain" href="https://docs.scrt.network/llms.txt" title="LLM index"><meta property="og:title" content="Quick Setup | Secret Network"><meta property="og:type" content="website"><meta property="og:site_name" content="Secret Network"><meta property="og:locale" content="en"><meta property="og:description" content="Run secret-setup.py to install secretd 1.27.2, register the node, and restore the secret-4 snapshot."><meta property="og:url" content="https://docs.scrt.network/"><meta property="og:image" content="https://docs.scrt.network/og/index.png"><meta property="og:image:alt" content="Secret Network operator documentation"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Quick Setup | Secret Network"><meta name="twitter:description" content="Run secret-setup.py to install secretd 1.27.2, register the node, and restore the secret-4 snapshot."><meta name="twitter:image" content="https://docs.scrt.network/og/index.png"><meta name="twitter:image:alt" content="Secret Network operator documentation"><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Quick Setup | Secret Network","description":"Run secret-setup.py to install secretd 1.27.2, register the node, and restore the secret-4 snapshot.","url":"https://docs.scrt.network/","inLanguage":"en",