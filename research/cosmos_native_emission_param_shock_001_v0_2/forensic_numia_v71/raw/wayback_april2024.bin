 16.7783Z" fill="currentColor"></path></svg>Powered by GitBook</a></div></div></div></aside><div class="flex-1 flex flex-col"><!--$--><div class="flex flex-row"><main class="flex-1 relative py-8 lg:px-12 break-anywhere page-api-block:xl:max-2xl:pr-0 page-api-block:max-w-[1654px] page-api-block:mx-auto"><header class="max-w-3xl mx-auto mb-6 space-y-3 page-api-block:ml-0"><h1 class="text-4xl font-bold">Secret Network</h1></header><div class="[&amp;&gt;*+*]:mt-5 grid whitespace-pre-wrap"><!--$--><p class="max-w-3xl w-full mx-auto decoration-primary/6 page-api-block:ml-0"><strong class="font-bold">Chain ID:</strong> secret_4</p><!--/$--><!--$--><p class="max-w-3xl w-full mx-auto decoration-primary/6 page-api-block:ml-0">For Secret Network you&#x27;ll find the following tables (new schema):</p><!--/$--><!--$--><ol class="space-y-2 flex flex-col [&amp;&gt;li]:gap-[1ch] [counter-reset:list-decimal] [&amp;&gt;li]:flex [&amp;&gt;li]:flex-row [&amp;&gt;li&gt;.bullet]:tabular-nums [&amp;&gt;li&gt;.bullet]:whitespace-nowrap [&amp;&gt;li&gt;.bullet]:list-decimal [&amp;&gt;li&gt;.bullet]:before:h-[1lh] [&amp;&gt;li&gt;.bullet]:before:leading-[inherit] [&amp;&gt;li&gt;.bullet]:before:flex [&amp;&gt;li&gt;.bullet]:text-dark/6 [&amp;&gt;li&gt;div_div]:mt-0 dark:[&amp;&gt;li&gt;.bullet]:text-light/6 max-w-3xl w-full mx-auto decoration-primary/6 page-api-block:ml-0"><!--$--><li value="1" class="leading-normal"><div data-value="1" class="bullet ListItem_olListItemBullet__9X19L text-base"></div><div class="space-y-2 flex-1 flex flex-col"><!--$--><p class="max-w-3xl w-full mx-auto decoration-primary/6 leading-normal min-h-[1lh] flip-heading-hash"><a class="underline underline-offset-2 text-primary hover:text-primary-700 transition-colors " href="/overview/sql-access/chains/secret-network#event-based-tables-raw">Raw Tables</a></p><!--/$--></div></li><!--/$--></ol><!--/$--><!--$--><h2 id="event-based-tables-raw" class="text-3xl font-semibold group relative grid max-w-3xl w-full mx-auto decoration-primary/6 page-api-block:ml-0"><div class="grid grid-area-1-1 relative -ml-6 w-7 border-0 opacity-0 group-hover:opacity-[0] group-focus:opacity-[0] md:group-hover:md:opacity-[1] md:group-focus:md:opacity-[1] [margin-top:_1em]"><a href="#event-based-tables-raw" aria-label="Direct link to heading" class="inline-flex h-full items-start dark:text-light/3 dark:shadow-none dark:ring-0 leading-tight"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" shape-rendering="geometricPrecision" viewBox="0 0 24 24" class="w-3.5 h-[1lh] transition-colors stroke-transparent group-hover:stroke-dark/6 dark:group-hover:stroke-light/5 lg:w-4" height="24" width="24" style="color:currentColor"><path d="M4 9h16M4 15h16M10 3L8 21M16 3l-2 18"></path></svg></a></div><div class="grid-area-1-1 z-[1] [margin-top:_1em]"><strong class="font-bold">Raw Tables</strong></div></h2><!--/$--><!--$--><p class="max-w-3xl w-full mx-auto decoration-primary/6 page-api-block:ml-0">When querying in BigQeury make sure you add the prefix <code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]"><i class="font-italic">secret_</i></code> to all of the name tables below. For example, the table blocks should be: </p><!--/$--><!--$--><p class="max-w-3xl w-full mx-auto decoration-primary/6 page-api-block:ml-0"><code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]">select * from numia-data.secret.secret_blocks </code></p><!--/$--><!--$--><div class="rounded-lg straight-corners:rounded-sm ring-1 ring-inset ring-dark/3 flex overflow-hidden flex-col dark:ring-light/2 max-w-3xl w-full mx-auto decoration-primary/6 page-api-block:ml-0"><div role="tablist" class="group/tabs inline-flex flex-row self-stretch after:flex-[1] after:bg-dark-2/1 [&amp;:has(button.active-tab:last-of-type):after]:rounded-bl-md dark:after:bg-dark-1/5"><button role="tab" aria-selected="true" aria-controls="tabpanel-f5be11fd8e8c4ccdbcdb120e605bd618" id="tab-f5be11fd8e8c4ccdbcdb120e605bd618" class="[&amp;:has(+_.active-tab)]:rounded-br-md [.active-tab_+_&amp;]:rounded-bl-md [.active-tab_+_:after]:rounded-br-md inline-block text-sm px-3.5 py-2 transition-[color] font-[500] relative after:transition-colors after:group-hover/tabs:border-transparent after:border-r after:absolute after:left-[unset] after:right-0 after:border-dark/4 after:top-[15%] after:h-[70%] after:w-[1px] last:after:border-transparent hover:text-dark-2 dark:after:border-light/2 dark:hover:text-light-3 truncate max-w-full shrink-0 active-tab text-dark-2 bg-transparent dark:text-light dark:bg-transparent after:[&amp;.active-tab]:border-transparent after:[:has(+_&amp;.active-tab)]:border-transparent after:[:has(&amp;_+)]:border-transparent">blocks</button><button role="tab" aria-selected="false" aria-controls="tabpanel-6f5f95fdd92342db80f571682afb6bb5" id="tab-6f5f95fdd92342db80f571682afb6bb5" class="[&amp;:has(+_.active-tab)]:rounded-br-md [.active-tab_+_&amp;]:rounded-bl-md [.active-tab_+_:after]:rounded-br-md inline-block text-sm px-3.5 py-2 transition-[color] font-[500] relative after:transition-colors after:group-hover/tabs:border-transparent after:border-r after:absolute after:left-[unset] after:right-0 after:border-dark/4 after:top-[15%] after:h-[70%] after:w-[1px] last:after:border-transparent text-dark-2/7 bg-dark-2/1 dark:bg-dark-1/5 hover:text-dark-2 dark:text-light-3/8 dark:after:border-light/2 dark:hover:text-light-3 truncate max-w-full">block_events</button><button role="tab" aria-selected="false" aria-controls="tabpanel-85162eee1fbc48f796aa0a96084da1ee" id="tab-85162eee1fbc48f796aa0a96084da1ee" class="[&amp;:has(+_.active-tab)]:rounded-br-md [.active-tab_+_&amp;]:rounded-bl-md [.active-tab_+_:after]:rounded-br-md inline-block text-sm px-3.5 py-2 transition-[color] font-[500] relative after:transition-colors after:group-hover/tabs:border-transparent after:border-r after:absolute after:left-[unset] after:right-0 after:border-dark/4 after:top-[15%] after:h-[70%] after:w-[1px] last:after:border-transparent text-dark-2/7 bg-dark-2/1 dark:bg-dark-1/5 hover:text-dark-2 dark:text-light-3/8 dark:after:border-light/2 dark:hover:text-light-3 truncate max-w-full">message_event</button><button role="tab" aria-selected="false" aria-controls="tabpanel-cf9cd1c8ae9f4bc2a08b5f1761e89232" id="tab-cf9cd1c8ae9f4bc2a08b5f1761e89232" class="[&amp;:has(+_.active-tab)]:rounded-br-md [.active-tab_+_&amp;]:rounded-bl-md [.active-tab_+_:after]:rounded-br-md inline-block text-sm px-3.5 py-2 transition-[color] font-[500] relative after:transition-colors after:group-hover/tabs:border-transparent after:border-r after:absolute after:left-[unset] after:right-0 after:border-dark/4 after:top-[15%] after:h-[70%] after:w-[1px] last:after:border-transparent text-dark-2/7 bg-dark-2/1 dark:bg-dark-1/5 hover:text-dark-2 dark:text-light-3/8 dark:after:border-light/2 dark:hover:text-light-3 truncate max-w-full">transactions</button><button role="tab" aria-selected="false" aria-controls="tabpanel-1b84dc6196ee4e40aa693c9bea7a072c" id="tab-1b84dc6196ee4e40aa693c9bea7a072c" class="[&amp;:has(+_.active-tab)]:rounded-br-md [.active-tab_+_&amp;]:rounded-bl-md [.active-tab_+_:after]:rounded-br-md inline-block text-sm px-3.5 py-2 transition-[color] font-[500] relative after:transition-colors after:group-hover/tabs:border-transparent after:border-r after:absolute after:left-[unset] after:right-0 after:border-dark/4 after:top-[15%] after:h-[70%] after:w-[1px] last:after:border-transparent text-dark-2/7 bg-dark-2/1 dark:bg-dark-1/5 hover:text-dark-2 dark:text-light-3/8 dark:after:border-light/2 dark:hover:text-light-3 truncate max-w-full">tx_messages</button><button role="tab" aria-selected="false" aria-controls="tabpanel-8a4833e769e746b9900f80d39d9eb2ff" id="tab-8a4833e769e746b9900f80d39d9eb2ff" class="[&amp;:has(+_.active-tab)]:rounded-br-md [.active-tab_+_&amp;]:rounded-bl-md [.active-tab_+_:after]:rounded-br-md inline-block text-sm px-3.5 py-2 transition-[color] font-[500] relative after:transition-colors after:group-hover/tabs:border-transparent after:border-r after:absolute after:left-[unset] after:right-0 after:border-dark/4 after:top-[15%] after:h-[70%] after:w-[1px] last:after:border-transparent text-dark-2/7 bg-dark-2/1 dark:bg-dark-1/5 hover:text-dark-2 dark:text-light-3/8 dark:after:border-light/2 dark:hover:text-light-3 truncate max-w-full">validators</button></div><div role="tabpanel" id="tabpanel-f5be11fd8e8c4ccdbcdb120e605bd618" aria-labelledby="tab-f5be11fd8e8c4ccdbcdb120e605bd618" class="p-4"><div class="w-full space-y-6"><!--$--><p class="max-w-3xl w-full mx-auto decoration-primary/6 flip-heading-hash">Contains each validated block in the chain. <code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]">block_timestamp</code> is only available in this table, so you need to do an <code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]">inner join on block_height</code> to get <code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]">block_timestamp</code> to the other tables.</p><!--/$--><!--$--><div class="max-w-3xl w-full decoration-primary/6 flip-heading-hash relative grid overflow-x-auto overflow-y-hidden mx-auto table_progressContainer__A4v1T"><div class="table_progressOpacitySharp__gzaM5 grid items-center grid-area-1-1 w-[5rem] h-full top-0 z-[1] sticky left-[calc(100%-5rem)]"><svg class="table_progressSvg__pg3ZZ grid-area-1-1 relative [strokeDasharray:_0_100] z-[1] w-7 mt-3 mr-3 self-start justify-self-end stroke-primary-600 shadow-1xs bg-light ring-1 ring-inset rounded-full ring-dark/2 dark:ring-light/2 dark:bg-dark dark:stroke-primary-400" preserveAspectRatio="xMaxYMid meet" width="100%" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="13" class="table_strokeOpacityProgressInverted__H5kWC" cy="13" r="12.5" fill="none" stroke="inherit" stroke-width="1.5" pathLength="100" stroke-linecap="round" stroke-opacity="0"></circle><path stroke-dasharray="none" d="M12 10L15 13L12 16" stroke="inherit" fill="none" stroke-opacity="0.64"></path></svg><div class="table_progressOpacity__vIKGt  bg-gradient-to-r from-transparent to-light to-40% grid-area-1-1 w-full h-full dark:from-transparent dark:to-dark/10"></div></div><table class="w-full grid-area-1-1 table-auto"><thead><tr class="[&amp;&gt;*+*]:border-l [&amp;&gt;*+*]:px-4"><th class="py-1 pt-0 align-middle text-balance border-b border-b-dark/5 text-left text-xs lg:text-base dark:border-l-light/2 dark:border-b-light/4" style="width:397px">Field</th><th class="py-1 pt-0 align-middle text-balance border-b border-b-dark/5 text-left text-xs lg:text-base dark:border-l-light/2 dark:border-b-light/4">Type</th></tr></thead><tbody class="[&amp;&gt;*+*]:border-t"><tr class="[&amp;&gt;*+*]:border-l [&amp;&gt;*+*]:pl-4 border-dark/3 dark:border-light/2"><td class="align-middle min-w-[8rem] border-dark/2 py-3 text-sm lg:text-base dark:border-light/2"><div class="pr-4 text-balance"><div class="w-full space-y-2 lg:space-y-3 leading-normal"><!--$--><p class="mx-auto decoration