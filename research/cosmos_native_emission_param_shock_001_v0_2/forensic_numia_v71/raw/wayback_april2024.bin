-y-3 leading-normal"><!--$--><p class="mx-auto decoration-primary/6 w-full max-w-[unset]">proposer_address</p><!--/$--></div></div></td><td class="align-middle min-w-[8rem] border-dark/2 py-3 text-sm lg:text-base dark:border-light/2"><div class="pr-4 text-balance"><div class="w-full space-y-2 lg:space-y-3 leading-normal"><!--$--><p class="mx-auto decoration-primary/6 w-full max-w-[unset]">STRING</p><!--/$--></div></div></td></tr><tr class="[&amp;&gt;*+*]:border-l [&amp;&gt;*+*]:pl-4 border-dark/3 dark:border-light/2"><td class="align-middle min-w-[8rem] border-dark/2 py-3 text-sm lg:text-base dark:border-light/2"><div class="pr-4 text-balance"><div class="w-full space-y-2 lg:space-y-3 leading-normal"><!--$--><p class="mx-auto decoration-primary/6 w-full max-w-[unset]">validators_hash</p><!--/$--></div></div></td><td class="align-middle min-w-[8rem] border-dark/2 py-3 text-sm lg:text-base dark:border-light/2"><div class="pr-4 text-balance"><div class="w-full space-y-2 lg:space-y-3 leading-normal"><!--$--><p class="mx-auto decoration-primary/6 w-full max-w-[unset]">STRING</p><!--/$--></div></div></td></tr></tbody></table></div><!--/$--></div></div><div role="tabpanel" id="tabpanel-6f5f95fdd92342db80f571682afb6bb5" aria-labelledby="tab-6f5f95fdd92342db80f571682afb6bb5" class="p-4 hidden"><div class="w-full space-y-6"><!--$--><p class="max-w-3xl w-full mx-auto decoration-primary/6 flip-heading-hash">Contains all events and their corresponding attributes partitioned by block_height. Does not contain events triggered from messages and transactions signed by addresses. Events and their corresponding <code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]">event_index</code> are relative to the parent <code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]">block</code> , not the message or transactions. Events are identified by the <code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]">event_type</code> column and contains attributes by identified by <code class="py-[1px] px-1.5 min-w-[1.625rem] inline-flex justify-center items-center ring-1 ring-inset ring-dark/1 bg-dark/[0.06] rounded text-dark/8 dark:ring-light/1 dark:bg-light/1 dark:text-light/7 text-[.875em] leading-[calc(max(1.20em,1.25rem))]">attribute_key</code>. </p><!--/$--><!--$--><div class="max-w-3xl w-full decoration-primary/6 flip-heading-hash relative grid overflow-x-auto overflow-y-hidden mx-auto table_progressContainer__A4v1T"><div class="table_progressOpacitySharp__gzaM5 grid items-center grid-area-1-1 w-[5rem] h-full top-0 z-[1] sticky left-[calc(100%-5rem)]"><svg class="table_progressSvg__pg3ZZ grid-area-1-1 relative [strokeDasharray:_0_100] z-[1] w-7 mt-3 mr-3 self-start justify-self-end stroke-primary-600 shadow-1xs bg-light ring-1 ring-inset rounded-full ring-dark/2 dark:ring-light/2 dark:bg-dark dark:stroke-primary-400" preserveAspectRatio="xMaxYMid meet" width="100%" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="13" class="table_strokeOpacityProgressInverted__H5kWC" cy="13" r="12.5" fill="none" stroke="inherit" stroke-width="1.5" pathLength="100" stroke-linecap="round" stroke-opacity="0"></circle><path stroke-dasharray="none" d="M12 10L15 13L12 16" stroke="inherit" fill="none" stroke-opacity="0.64"></path></svg><div class="table_progressOpacity__vIKGt  bg-gradient-to-r from-transparent to-light to-40% grid-area-1-1 w-full h-full dark:from-transparent dark:to-dark/10"></div></div><table class="w-full grid-area-1-1 table-auto"><thead><tr class="[&amp;&gt;*+*]:border-l [&amp;&gt;*+*]:px-4"><th class="py-1 pt-0 align-middle text-balance border-b border-b-dark/5 text-left text-xs lg:text-base dark:border-l-light/2 dark:border-b-light/4" style="width:315px">Field</th><th class="py-1 pt-0 align-middle text-balance border-b border-b-dark/5 text-left text-xs lg:text-base dark:border-l-light/2 dark:border-b-light/4" style="width:429px">Type</th></tr></thead><tbody class="[&amp;&gt;*+*]:border-t"><tr class="[&amp;&gt;*+*]:border-l [&amp;&gt;*+*]:pl-4 border-dark/3 dark:border-light/2"><td class="align-middle min-w-[8rem] border-dark/2 py-3 text-sm lg:text-base dark:border-light/2"><div class="pr-4 text-balance"><div class="w-full space-y-2 lg:space-y-3 leading-normal"><!--$--><p class="mx-auto decoration-primary/6 w-full max-w-[unset]">block_height</p><!--/$--></div></div></td><td class="align-middle min-w-[8rem] border-dark/2 py-3 text-sm lg:text-base dark:border-light/2"><div class="pr-4 text-balance"><div class="w-full space-y-2 lg:space-y-3 leading-normal"><!--$--><p class="mx-auto decoration-primary/6 w-full max-w-[unset]">INTEGER</p><!--/$--></div></div></td></tr><tr class="[&amp;&gt;*+*]:border-l [&amp;&gt;*+*]:pl-4 border-dark/3 dark:border-light/2"><td class="align-middle min-w-[8rem] border-dark/2 py-3 text-sm lg:text-base dark:border-light/2"><div class="pr-4 text-balance"><div class="w-full space-y-2 lg:space-y-3 leading-normal"><!--$--><p class="mx-auto decoration-primary/6 w-full max-w-[unset]">block_timestamp</p><!--/$--></div></div></td><td class="align-middle min-w-[8rem] border-dark/2 py-3 text-sm lg:text-base dark:border-light/2"><div class="pr-4 text-balance"><div class="w-full space-y-2 lg:space-y-3 leading-normal"><!--$--><p class="mx-auto decoration-primary/6 w-full max-w-[unset]">TIMESTAMP</p><!--/$--></div></div></td></tr><tr class="[&amp;&gt;*+*]:border-l [&amp;&gt;*+*]:pl-4 border-dark/3 d