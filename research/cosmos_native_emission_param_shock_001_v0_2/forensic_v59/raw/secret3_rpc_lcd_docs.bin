<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><script type="a58f4a763eaf5554292dc581-text/javascript">
      (() => {
        const KEY = "theme";
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const readPref = () => {
          try {
            const v = localStorage.getItem(KEY);
            return v === "dark" || v === "light" || v === "system" ? v : "system";
          } catch {
            return "system";
          }
        };

        const resolveMode = () => {
          const pref = readPref();
          if (pref === "system") return media.matches ? "dark" : "light";
          return pref;
        };

        const applyTheme = () => {
          const root = document.documentElement;
          const pref = readPref();
          const mode = resolveMode();
          if (mode === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          root.setAttribute("data-theme", pref);
          root.style.colorScheme = mode;
          document.querySelectorAll("[data-nb-theme-toggle]").forEach((b) => {
            b.setAttribute("data-nb-state", mode);
            b.setAttribute("data-nb-pref", pref);
          });
        };

        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        media.addEventListener("change", () => {
          if (!readPref()) applyTheme();
        });
        window.addEventListener("storage", (e) => {
          if (e.key === KEY) applyTheme();
        });

        window.__nbApplyTheme = applyTheme;
      })();
    </script><title>RPC and LCD | Secret Network</title><meta name="generator" content="Astro v7.3.1"><meta name="description" content="After catching_up is false, keep RPC, LCD, and gRPC on loopback and publish only a proxy."><link rel="icon" type="image/x-icon" href="/favicon.ico"><link rel="stylesheet" href="/_nimbus/shiki.css"><link rel="canonical" href="https://docs.scrt.network/operators/rpc-lcd/"><link rel="sitemap" href="/sitemap-index.xml"><link rel="alternate" type="text/markdown" href="https://docs.scrt.network/operators/rpc-lcd/index.md"><link rel="alternate" type="text/plain" href="https://docs.scrt.network/llms.txt" title="LLM index"><meta property="og:title" content="RPC and LCD | Secret Network"><meta property="og:type" content="article"><meta property="og:site_name" content="Secret Network"><meta property="og:locale" content="en"><meta property="og:description" content="After catching_up is false, keep RPC, LCD, and gRPC on loopback and publish only a proxy."><meta property="og:url" content="https://docs.scrt.network/operators/rpc-lcd/"><meta property="og:image" content="https://docs.scrt.network/og/operators/rpc-lcd.png"><meta property="og:image:alt" content="Secret Network operator documentation"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="article:modified_time" content="2026-10-03T00:00:00.000Z"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="RPC and LCD | Secret Network"><meta name="twitter:description" content="After catching_up is false, keep RPC, LCD, and gRPC on loopback and publish only a proxy."><meta name="twitter:image" content="https://docs.scrt.network/og/operators/rpc-lcd.png"><meta name="twitter:image:alt" content="Secret Network operator documentation"><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","name":"RPC and LCD | Secret Network","description":"After catching_up is false, keep RPC