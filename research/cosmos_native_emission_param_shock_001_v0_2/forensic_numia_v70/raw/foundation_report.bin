;width:100%;margin:12px 0 28px}.choice-row .text-link,.choice-row span{display:flex;align-items:center;justify-content:center;min-height:52px;margin:0;padding:10px 12px;border-radius:12px;background:#ffffff0f;font-family:var(--font-ui);font-weight:500;font-size:16px;line-height:22px;text-align:center}.choice-row span{color:var(--white)}.info-grid-actions{margin-top:8px}.info-grid-actions .info-card{display:flex;flex-direction:column;align-items:flex-start;gap:16px}.info-grid-actions .info-card :is(h2,p){margin:0}.info-grid-actions .info-card .btn{margin:auto 0 0}.info-card .text-link{margin:8px 0 0}.inquiry-form{display:flex;flex-direction:column;gap:14px;width:100%;max-width:480px;margin-top:12px}.inquiry-form label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-family:var(--font-ui);font-weight:500;font-size:12px}.inquiry-form input,.inquiry-form textarea{width:100%;padding:12px;border:0;border-radius:10px;background:var(--white);color:var(--ink);font-family:var(--font-ui);font-weight:500;font-size:14px}.inquiry-form textarea{min-height:120px;resize:vertical}.form-submit{width:fit-content;height:40px;padding:0 18px;border:0;border-radius:10px;background:var(--ink);color:var(--white);font-family:"Inter Variable",var(--font-ui);font-size:14px;cursor:pointer}.post,.measure{display:flex;flex-direction:column;align-items:flex-start;gap:16px}.page.measure{width:min(68rem,calc(100% - 100px));align-items:stretch}.measure :is(h1,h2,h3,p,ul,blockquote,.text-link,.button-row){width:100%;max-width:none}.measure :is(h1,h2,h3){margin:0}.measure p{margin:0;line-height:1.6}.article-body{display:flex;flex-direction:column;align-items:flex-start;gap:16px;width:100%}.blog-index :is(h1,h2,p,.kicker,.featured,.post-grid){max-width:none}@media(max-width:809.98px){.page,.page.measure{width:min(1200px,calc(100% - 40px));padding-top:188px}.page h1{font-size:30px;line-height:36px}.info-grid{grid-template-columns:1fr}.info-card{padding:24px}.choice-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}}@media(min-width:810px)and (max-width:1199.98px){.info-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.choice-row{grid-template-columns:repeat(3,minmax(0,1fr))}}
