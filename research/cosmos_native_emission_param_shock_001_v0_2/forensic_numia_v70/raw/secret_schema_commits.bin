[{"sha":"b4678acd4a41180922e8281dfa5345245dbf9b2e","node_id":"C_kwDONLwpEdoAKGI0Njc4YWNkNGE0MTE4MDkyMmU4MjgxZGZhNTM0NTI0NWRiZjliMmU","commit":{"author":{"name":"Lucas García de Viedma Pérez","email":"72617878+Lucasgvdii@users.noreply.github.com","date":"2025-12-02T17:59:02Z"},"committer":{"name":"Lucas García de Viedma Pérez","email":"72617878+Lucasgvdii@users.noreply.github.com","date":"2025-12-02T17:59:02Z"},"message":"Add descriptions and tags to Cosmos data tables\n\nEnhanced multiple Cosmos-related JSON table schemas by adding or updating descriptions and tags for tables and columns. This improves documentation, clarity, and consistency across datasets such as akash, axelar_dojo, celestia, comdex, core, cosmoshub, and others.","tree":{"sha":"6f4658e6e8dca9b237659b906fdbe9884346770c","url":"https://api.github.com/repos/numiadata/numia-docs/git/trees/6f4658e6e8dca9b237659b906fdbe9884346770c"},"url":"https://api.github.com/repos/numiadata/numia-docs/git/commits/b4678acd4a41180922e8281dfa5345245dbf9b2e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/numiadata/numia-docs/commits/b4678acd4a41180922e8281dfa5345245dbf9b2e","html_url":"https://github.com/numiadata/numia-docs/commit/b4678acd4a41180922e8281dfa5345245dbf9b2e","comments_url":"https://api.github.com/repos/numiadata/numia-docs/commits/b4678acd4a41180922e8281dfa5345245dbf9b2e/comments","author":{"login":"Lucasgvdii","id":72617878,"node_id":"MDQ6VXNlcjcyNjE3ODc4","avatar_url":"https://avatars.githubusercontent.com/u/72617878?v=4","gravatar_id":"","url":"https://api.github.com/users/Lucasgvdii","html_url":"https://github.com/Lucasgvdii","followers_url":"https://api.github.com/users/Lucasgvdii/followers","following_url":"https://api.github.com/users/Lucasgvdii/following{/other_user}","gists_url":"https://api.github.com/users/Lucasgvdii/gists{/gist_id}","starred_url":"https://api.github.com/users/Lucasg