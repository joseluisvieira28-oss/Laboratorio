b.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":53814272,"digest":null,"download_count":5,"created_at":"2023-09-05T09:31:51Z","updated_at":"2023-09-05T09:31:54Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.11.0-beta.2/secretcli-Windows"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/124620507","id":124620507,"node_id":"RA_kwDODh_DHs4HbY7b","name":"secretnetwork_1.11.0-beta.2_testnet_goleveldb_amd64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":40664212,"digest":null,"download_count":33,"created_at":"2023-09-05T09:31:51Z","updated_at":"2023-09-05T09:31:53Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.11.0-beta.2/secretnetwork_1.11.0-beta.2_testnet_goleveldb_amd64.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.11.0-beta.2","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.11.0-beta.2","body":"# :warning: TESTNET :warning:\r\n\r\n## Upgrade instructions\r\n```bash\r\n# Backup your node's SGX secrets\r\ncp -a /opt/secret/.sgx_secrets ~/sgx_secrets_backup\r\nmkdir 110backup\r\ncp ~/.secretd/.node/* 110backup/\r\n\r\n# Get the v1.11 binaries\r\nwget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.11.0-beta.2/secretnetwork_1.11.0-beta.2_testnet_goleveldb_amd64.deb\"\r\n\r\n# Verify the v1.11 binaries\r\necho '723a2d03ec51deadf4675f8363e79ae85c2965ea94fe9cc8d6063eb58062e40f secretnetwork_1.11.0-beta.2_testnet_goleveldb_amd64.deb' | sha256sum --check\r\n\r\n# Stop the v1.10 node\r\nsudo systemctl stop secret-node\r\n\r\n# Install the v1.11 binaries\r\nsudo apt install -y \"./secretnetwork_1.11.0-beta.2_testnet_goleveldb_amd64.deb\"\r\n\r\n# re-apply any systemd unit file customizations\r\n\r\n# Restart the node\r\nsudo systemctl restart secret-node\r\n```\r\n\r\n## What's Changed\r\n* quick patch test-v1.9-upgrade-handler.md by @eshelB in https://github.com/scrtlabs/SecretNetwork/pull/1435\r\n* Change base docker by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1456\r\n* Verify new message type2 by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1452\r\n* V1.9.x by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1453\r\n* IBC Hooks by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1408\r\n* Light client input validation (IBC Hooks + IBC contracts) by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1441\r\n* Fix vesting module initialization by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1460\r\n* Bump log from 0.4.14 to 0.4.19 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1461\r\n* Bump golang.org/x/crypto from 0.8.0 to 0.10.0 by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1462\r\n* Bump sha2 from 0.9.9 to 0.10.7 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1463\r\n* Bump serde_json from 1.0.95 to 1.0.97 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1464\r\n* Bump serde_json from 1.0.97 to 1.0.99 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1469\r\n* Bump num_cpus from 1.14.0 to 1.16.0 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1472\r\n* Bump serde from 1.0.159 to 1.0.166 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1473\r\n* secret-contract-optimizer: support multiple contracts by @luca992 in https://github.com/scrtlabs/SecretNetwork/pull/1471\r\n* Bump serde_json from 1.0.99 to 1.0.100 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1474\r\n* Bump golang.org/x/crypto from 0.10.0 to 0.11.0 by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1475\r\n* Bump serde from 1.0.166 to 1.0.167 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1476\r\n* Bump serde from 1.0.167 to 1.0.171 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1477\r\n* Bump serde_json from 1.0.100 to 1.0.102 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1479\r\n* Bump serde_json from 1.0.102 to 1.0.103 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1480\r\n* Bump serde from 1.0.171 to 1.0.179 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1491\r\n* Bump github.com/rs/zerolog from 1.29.1 to 1.30.0 by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1492\r\n* Bump tempfile from 3.5.0 to 3.7.0 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1482\r\n* Bump serde_json from 1.0.103 to 1.0.104 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1488\r\n* IBC Hooks: send acks & timeouts to `sudo()` instead of `execute()` by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1493\r\n* Contract Upgrade by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1449\r\n* Bump serde from 1.0.179 to 1.0.181 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1499\r\n* secret-contract-optimizer: only build libraries by @kent-3 in https://github.com/scrtlabs/SecretNetwork/pull/1484\r\n* Bump tempfile from 3.7.0 to 3.7.1 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1502\r\n* Bump serde from 1.0.181 to 1.0.182 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1501\r\n* Bump golang.org/x/crypto from 0.11.0 to 0.12.0 by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1503\r\n* SNIP-52: Add `env.transaction.hash` by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1498\r\n* Stop the compiler from complaining that `sig_info` is not used by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1506\r\n* Bump serde from 1.0.182 to 1.0.183 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1504\r\n* Support compiling contracts with Rust v1.70+ by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1500\r\n* Bump tendermint, cosmos sdk & rust & sgx-sdk to latest versions by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1497\r\n* Check hw separate flow by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1509\r\n* Flush the cache in a random order by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1410\r\n* bumped iavl  by @eshelB in https://github.com/scrtlabs/SecretNetwork/pull/1520\r\n* Bump serde from 1.0.183 to 1.0.185 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1514\r\n* Bump log from 0.4.19 to 0.4.20 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1508\r\n* Bump serde_json from 1.0.104 to 1.0.105 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1510\r\n* Bump tempfile from 3.7.1 to 3.8.0 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1511\r\n* Bump ibc v4.4.2 + sdk by @eshelB in https://github.com/scrtlabs/SecretNetwork/pull/1517\r\n* Bump gonum.org/v1/gonum from 0.12.0 to 0.14.0 by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1512\r\n* Bump serde from 1.0.185 to 1.0.186 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1521\r\n* Hardcoded upgrade admins by @eshelB in https://github.com/scrtlabs/SecretNetwork/pull/1522\r\n* Hmac all the things by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1523\r\n* Fix release ci by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1526\r\n* V1.11 fixes by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1529\r\n* Fix storage folder by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1530\r\n* Bump base64 from 0.12.3 to 0.21.3 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1525\r\n* Bump serde from 1.0.186 to 1.0.188 in /cosmwasm by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1524\r\n* Bump actions/checkout from 3 to 4 by @dependabot in https://github.com/scrtlabs/SecretNetwork/pull/1531\r\n* Add cli for migration by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1527\r\n\r\n\r\n**Full Changelog**: https://github.com/scrtlabs/SecretNetwork/compare/v1.10.0...v1.11.0-beta.2","mentions_count":7},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/118990615","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/118990615/assets","upl