url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.github.com/users/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/assafmo/subscriptions","organizations_url":"https://api.github.com/users/assafmo/orgs","repos_url":"https://api.github.com/users/assafmo/repos","events_url":"https://api.github.com/users/assafmo/events{/privacy}","received_events_url":"https://api.github.com/users/assafmo/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/vnd.debian.binary-package","state":"uploaded","size":37821860,"digest":null,"download_count":25,"created_at":"2022-09-08T11:39:03Z","updated_at":"2022-09-08T11:39:27Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.0-beta.5/secretnetwork_1.4.0-beta.5_testnet_goleveldb_amd64.deb"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/77236268","id":77236268,"node_id":"RA_kwDODh_DHs4Emogs","name":"secretnetwork_1.4.0-beta.5_testnet_rocksdb_amd64.deb","label":null,"uploader":{"login":"assafmo","id":22766533,"node_id":"MDQ6VXNlcjIyNzY2NTMz","avatar_url":"https://avatars.githubusercontent.com/u/22766533?v=4","gravatar_id":"","url":"https://api.github.com/users/assafmo","html_url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.github.com/users/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/assafmo/subscriptions","organizations_url":"https://api.github.com/users/assafmo/orgs","repos_url":"https://api.github.com/users/assafmo/repos","events_url":"https://api.github.com/users/assafmo/events{/privacy}","received_events_url":"https://api.github.com/users/assafmo/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/vnd.debian.binary-package","state":"uploaded","size":41901412,"digest":null,"download_count":15,"created_at":"2022-09-08T11:38:37Z","updated_at":"2022-09-08T11:39:03Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.0-beta.5/secretnetwork_1.4.0-beta.5_testnet_rocksdb_amd64.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.4.0-beta.5","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.4.0-beta.5","body":"# Shockwave Delta (Testnet)\r\n\r\nThe v1.4.0 software upgrade is set for **Thursday, 8 September 2022 at 2:00PM UTC**.\r\n\r\n## Upgrade instructions\r\n\r\nhttps://docs.scrt.network/secret-network-documentation/post-mortems-upgrades/upgrade-instructions/shockwave-delta-testnet\r\n\r\n## What's Changed\r\n* v1.3.1 and docker by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/933\r\n* AnalyzeCode functionality by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/935\r\n* Cosmwasm V1 IBC by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/936\r\n* Node updating script by @dbriggsie in https://github.com/scrtlabs/SecretNetwork/pull/938\r\n* Instantiate event by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/939\r\n* Fix for CI aesm by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/948\r\n* Port v0.10 test contract to v1 by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/944\r\n* Lior cosmwasm v1 by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/952\r\n* Cw v1 refactor output structure by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/955\r\n* Support old CPUs in `SGX_MODE=SW` by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/951\r\n* Fix CI & Test Bank::MsgSend for CosmWasm v1 & v0.10 by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/958\r\n* Port dev image faucet from python to node #957 by @levackt in https://github.com/scrtlabs/SecretNetwork/pull/959\r\n* gofumpt -w -l . by @faddat in https://github.com/scrtlabs/SecretNetwork/pull/946\r\n* add gitpod develeopment environment by @faddat in https://github.com/scrtlabs/SecretNetwork/pull/953\r\n* Port dev image faucet from python to node #961 by @levackt in https://github.com/scrtlabs/SecretNetwork/pull/963\r\n* fumpt the v1 work by @faddat in https://github.com/scrtlabs/SecretNetwork/pull/965\r\n* Test v1 BankMsg::Burn & v0.10+v1 CosmosMsg::Custom by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/962\r\n* go 1.18 by @faddat in https://github.com/scrtlabs/SecretNetwork/pull/947\r\n* Feature/node faucet by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/961\r\n* + Reverted xgo version to one that doesn't fail by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/972\r\n* Added dev environment for vscode/docker/gitpod by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/971\r\n* Changing log levels a bit to make running localsecret easier to parse by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/950\r\n* Custom chain ID from env by @levackt in https://github.com/scrtlabs/SecretNetwork/pull/970\r\n* Getting started docs by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1022\r\n* test: use `T.TempDir` to create temporary test directory by @Juneezee in https://github.com/scrtlabs/SecretNetwork/pull/1021\r\n* settings by @faddat in https://github.com/scrtlabs/SecretNetwork/pull/967\r\n* Change query depth limit from 5 to 10 by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1062\r\n* Fix another recursion test by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1068\r\n* Cosmwasm v1 funds tests by @eshelB in https://github.com/scrtlabs/SecretNetwork/pull/1070\r\n* Lior update wasmd 028 by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1069\r\n* Print proper error when unknown code id by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1074\r\n* Fixed startup script to be a bit friendlier. By default will run ./se… by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1078\r\n* Correct the error in label cli by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1075\r\n* Fix list-contract-by-code output by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1077\r\n* Fix 2 possible null drefs by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1083\r\n* Fix contract-hash command in cli by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1076\r\n* Add missing RPC function and make proto file readable by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1081\r\n* Add all of the missing RPC apis by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1080\r\n* Create contract hash by ID api both for CLI and RPC by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1079\r\n* update CI by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1090\r\n* Fix CI by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1091\r\n* Fix possible null-dref by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1092\r\n* Fix go linter warnings (including some more null-drefs) by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1093\r\n* stop using ioutil by @faddat in https://github.com/scrtlabs/SecretNetwork/pull/1066\r\n* Limit length of error messages by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1086\r\n* Eshel ibc env refactor by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1095\r\n* IBC packet receive tests and bug fixes by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1096\r\n* All IBC tests by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1097\r\n* Fix gtests by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1098\r\n* Lior ibc tests by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1099\r\n* Cosmwasm v1 with every by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1105\r\n* WIP: CosmWasm v1 IBC Receive Hooks by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/966\r\n* StargateQuery (and more) by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1073\r\n* IBC + Stargate + wasmd 0.28 by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1101\r\n* Fix redundant base64 in SubMsgResponse by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1107\r\n* Ibc integration tests by @eshelB in https://github.com/scrtlabs/SecretNetwork/pull/1113\r\n* Fix CI by uploading the artifacts by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1110\r\n* Fix xbuild the same way as it was fixed in master by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1115\r\n* CW v1 supports every error rather than only StdErrors in query by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1114\r\n* Split events when using StoreCode by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1111\r\n* Fixed that stupid dependency on SGX_MODE in secretcli by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1104\r\n* Add `/cosmos/tx/v1beta1` to swagger by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1117\r\n* go-1.19 by @faddat in https://github.com/scrtlabs/SecretNetwork/pull/1067\r\n* Refactor integration tests + Test MsgDelegate by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1118\r\n* Fix CI + More Stuff by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1121\r\n* Add support for nano ledger s+ by @bjaanes in https://github.com/scrtlabs/SecretNetwork/pull/1123\r\n* Gitignore by @faddat in https://github.com/scrtlabs/SecretNetwork/pull/969\r\n* make go tests start up faster when rerunning them by @reuvenpo in https://github.com/scrtlabs/SecretNetwork/pull/1124\r\n* more perf adjustments to go tests by @reuvenpo in https://github.com/scrtlabs/SecretNetwork/pull/1125\r\n* Fix EIP191 signature verification inside the enclave by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1127\r\n* Lint CosmWasm v1 by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1129\r\n* More CosmWasm v1 Integration Tests by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1128\r\n* Overhaul gRPC queries by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1130\r\n* Add ibc routing for compute module by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1132\r\n* Init tx info by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1131\r\n* Stderr logs cosmwasmv1 by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1134\r\n* v1.4 upgrade handler by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1109\r\n* Decrypt multiple txs `q compute tx` by @toml01 in https://github.com/scrtlabs/SecretNetwork/pull/1135\r\n* Ibc integration tests cw by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1137\r\n* Bump gas costs to 100K per contract instance and another 200_000 (was… by @Cashmaney in https://github.com/scrtlabs/SecretNetwork/pull/1133\r\n* Fix release by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1139\r\n* Fix `secretcli q compute tx` data field decryption by @assafmo in https://github.com/scrtlabs/SecretNetwork/pull/1140\r\n* Add validate test by @liorbond in https://github.com/scrtlabs/SecretNetwork/pull/1141\r\n\r\n## New Contributors\r\n* @Juneezee made their first contribution in https://github.com/scrtlabs/SecretNetwork/pull/1021\r\n* @eshelB made their first contribution in https://github.com/scrtlabs/SecretNetwork/pull/1070\r\n* @bjaanes made their first contribution in https://github.com/scrtlabs/SecretNetwork/pull/1123\r\n\r\n**Full Changelog**: https://github.com/scrtlabs/SecretNetwork/compare/v1.3.1...v1.4.0-beta.5","mentions_count":11},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/67847495","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/67847495/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/67847495/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.3.1","id":67847495,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"node_id":"RE_kwDODh_DHs4EC0VH","tag_name":"v1.3.1","target_commitish":"master","name":"v1.3.1","draft":false,"immutable":false,"prerelease":false,"created_at":"2022-05-25T18:56:59Z","updated_at":"2022-05-26T10:01:41Z","published_at":"2022-05-25T20:01:26Z","assets":[{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/66628518","id":66628518,"node_id":"RA_kwDODh_DHs4D-Kum","name":"