ets/202622205","id":202622205,"node_id":"RA_kwDODh_DHs4ME8T9","name":"secretnetwork_1.15.0-beta.4_testnet_goleveldb_amd64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":60880380,"digest":null,"download_count":16,"created_at":"2024-10-29T15:56:44Z","updated_at":"2024-10-29T15:56:45Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.15.0-beta.4/secretnetwork_1.15.0-beta.4_testnet_goleveldb_amd64.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.15.0-beta.4","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.15.0-beta.4","body":"# :warning: TESTNET :warning:\r\n\r\n### What's changed\r\n\r\n- Update cosmos-sdk to v0.50.10. All the related changes can be found [here](https://github.com/cosmos/cosmos-sdk/blob/release/v0.50.x/CHANGELOG.md).\r\n- Update ibc-go to v8.1.0. Full changelog can be found [here](https://github.com/cosmos/ibc-go/blob/release/v8.1.x/CHANGELOG.md).\r\n- Update cometbft to v0.38.12. Full changelog can be found [here](https://github.com/cometbft/cometbft/blob/v0.38.12/CHANGELOG.md).\r\n- Update build OS to Ubuntu 22.04.\r\n- Update rust-toolchain to nightly-2023-03-13.\r\n- Migrate `x/emergencybutton` to self-managed parameters and deprecate it's usage of `x/params`.\r\n\r\n### Breaking Changes\r\n\r\n- SecretCLI - A lot of `secretcli` commands have changed. For the full list of CLI Breaking Changes please see: [1](https://github.com/cosmos/cosmos-sdk/blob/main/CHANGELOG.md#cli-breaking-changes-4), [2](https://github.com/cosmos/cosmos-sdk/blob/main/CHANGELOG.md#cli-breaking-changes-3), [3](https://github.com/cosmos/cosmos-sdk/blob/main/CHANGELOG.md#cli-breaking-changes-2), [4](https://github.com/cosmos/cosmos-sdk/blob/main/CHANGELOG.md#cli-breaking-changes-1).\r\n- Secret.js - From the current release secret.js v1.15.x or later is required. This version is API breaking, see the secret.js [changelog](https://github.com/scrtlabs/secret.js/blob/v1.15.0-beta.0/CHANGELOG.md).\r\n- Keplr - From the current release keplr v0.12.142 or later is required. Update instructions [here](https://help.keplr.app/articles/updating-your-chrome-extension).\r\n- Remove `mauth` module in favor of `27-interchain-accounts`, which has the same functionality.\r\n- Remove legacy REST API.\r\n\r\n## Upgrade instructions\r\n```bash\r\n# Backup your node's SGX secrets\r\ncp -a /opt/secret/.sgx_secrets ~/sgx_secrets_backup\r\nmkdir 115-beta.4backup\r\ncp -r ~/.secretd/* 115-beta.4backup/\r\n\r\nwget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.15.0-beta.4/secretnetwork_1.15.0-beta.4_testnet_goleveldb_amd64.deb\"\r\n\r\nsudo systemctl stop secret-node\r\n\r\nsudo apt install -y \"./secretnetwork_1.15.0-beta.4_testnet_goleveldb_amd64.deb\"\r\n\r\n# re-apply any systemd unit file customizations\r\n\r\n# Restart the node\r\nsudo systemctl restart secret-node\r\n```\r\n\r\n**Full Changelog**: https://github.com/scrtlabs/SecretNetwork/compare/v1.14.0...v1.15.0-beta.4"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/172375667","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/172375667/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/172375667/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.14.0","id":172375667,"author":{"login":"iKapitonau","id":44369865,"node_id":"MDQ6VXNlcjQ0MzY5ODY1","avatar_url":"https://avatars.githubusercontent.com/u/44369865?v=4","gravatar_id":"","url":"https://api.github.com/users/iKapitonau","html_url":"https://github.com/iKapitonau","followers_url":"https://api.github.com/users/iKapitonau/followers","following_url":"https://api.github.com/users/iKapitonau/following{/other_user}","gists_url":"https://api.github.com/users/iKapitonau/gists{/gist_id}","starred_url":"https://api.github.com/users/iKapitonau/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iKapitonau/subscriptions","organizations_url":"https://api.github.com/users/iKapitonau/orgs","repos_url":"https://api.github.com/users/iKapitonau/repos","events_url":"https://api.github.com/users/iKapitonau/events{/privacy}","received_events_url":"https://api.github.com/users/iKapitonau/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDODh_DHs4KRj5z","tag_name":"v1.14.0","target_commitish":"master","name":"v1.14.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2024-08-28T13:28:47Z","updated_at":"2024-08-28T14:34:17Z","published_at":"2024-08-28T14:21:32Z","assets":[{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/188870914","id":188870914,"node_id":"RA_kwDODh_DHs4LQfEC","name":"check_hw_1.14.0.tar.gz","label":"","uploader":{"login":"github-actions[bot]","