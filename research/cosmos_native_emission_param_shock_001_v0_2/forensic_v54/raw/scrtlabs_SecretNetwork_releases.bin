User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":26691332,"digest":null,"download_count":46,"created_at":"2022-03-10T11:13:09Z","updated_at":"2022-03-10T11:13:28Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.2.5/secretnetwork_1.2.6vg_goleveldb_amd64.deb"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/59104506","id":59104506,"node_id":"RA_kwDODh_DHs4Dhdz6","name":"secretnetwork_1.2.6vr_rocksdb_amd64.deb","label":null,"uploader":{"login":"Cashmaney","id":16579705,"node_id":"MDQ6VXNlcjE2NTc5NzA1","avatar_url":"https://avatars.githubusercontent.com/u/16579705?v=4","gravatar_id":"","url":"https://api.github.com/users/Cashmaney","html_url":"https://github.com/Cashmaney","followers_url":"https://api.github.com/users/Cashmaney/followers","following_url":"https://api.github.com/users/Cashmaney/following{/other_user}","gists_url":"https://api.github.com/users/Cashmaney/gists{/gist_id}","starred_url":"https://api.github.com/users/Cashmaney/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cashmaney/subscriptions","organizations_url":"https://api.github.com/users/Cashmaney/orgs","repos_url":"https://api.github.com/users/Cashmaney/repos","events_url":"https://api.github.com/users/Cashmaney/events{/privacy}","received_events_url":"https://api.github.com/users/Cashmaney/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":28888932,"digest":null,"download_count":75,"created_at":"2022-03-10T11:13:28Z","updated_at":"2022-03-10T11:13:53Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.2.5/secretnetwork_1.2.6vr_rocksdb_amd64.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.2.5","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.2.5","body":"**Update**: v1.2.5 contained a very, very rare unknown bug that caused a consensus mismatch with 1.2.2. To address this we reverted the bump of the cosmos sdk versions and released 1.2.6.  If you're using `v1.2.5`  please upgrade to this version, especially if you are using a validator\r\n\r\nArchitecture now split into query nodes and validator nodes. Query nodes contain optimizations that may not be entirely safe for validators and greatly improve querying performance. In addition, contracts are now served by two different enclaves: Query enclaves and execute enclaves. This will allow upgrading query enclave and improving performance without consensus-breaking changes. Lastly, rocksdb support is enabled. We are releasing binaries for each supported Database. Rocksdb is recommended for performance, but requires a resync of any nodes currently running goleveldb. Rocksdb currently only supported for Ubuntu 20.04. Using this release will require machines with at least 32GB of RAM (up from a minimum of 16).\r\n\r\nThis release focuses mostly on **querying node only**. We are providing validator binaries for benchmarking and testing purposes only. **Use at your own risk**.\r\n\r\nVersion notation: secretnetwork_[version][query/validator][database type]_[cpu arch]\r\n\r\nSee changelog for more details","reactions":{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/60562267/reactions","total_count":19,"+1":0,"-1":0,"laugh":4,"hooray":0,"confused":0,"heart":0,"rocket":9,"eyes":6}},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/53898885","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/53898885/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/53898885/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.2.2","id":53898885,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"h