ars.githubusercontent.com/u/9623498?v=4","gravatar_id":"","url":"https://api.github.com/users/valdok","html_url":"https://github.com/valdok","followers_url":"https://api.github.com/users/valdok/followers","following_url":"https://api.github.com/users/valdok/following{/other_user}","gists_url":"https://api.github.com/users/valdok/gists{/gist_id}","starred_url":"https://api.github.com/users/valdok/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/valdok/subscriptions","organizations_url":"https://api.github.com/users/valdok/orgs","repos_url":"https://api.github.com/users/valdok/repos","events_url":"https://api.github.com/users/valdok/events{/privacy}","received_events_url":"https://api.github.com/users/valdok/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":64893962,"digest":"sha256:fc6bb166e5ed8bf9cd0fac528744d14bcbd8aa7080856c3fa160840f38218293","download_count":6,"created_at":"2025-10-30T11:43:55Z","updated_at":"2025-10-30T11:44:16Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.23.0/secretnetwork_1.23.0_testnet_goleveldb_amd64_ubuntu-24.04.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.23.0","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.23.0","body":"# What's Changed\r\n* New nodes can be added via Governance\r\n* Any Azure nodes are accepted to the network without limitations\r\n* Implemented WasmD patch CWA-2025-007\r\n* Implemented CosmosSDK patch ASA-2025-003\r\n* Added notification about unsupported hardware, including EOL machines\r\n\r\n**Full Changelog**: https://github.com/scrtlabs/SecretNetwork/compare/v1.21.7...v1.23.0\r\n\r\n\r\n# Upgrade instructions (testnet)\r\n\r\n## 1. Download check-hw tool, extract and run the upgrade script\r\n```\r\nwget https://github.com/scrtlabs/SecretNetwork/releases/download/v1.23.0/check_hw_1.23.0_ubuntu-22.04.tar.gz\r\ntar -xzvf check_hw_1.23.0_ubuntu-22.04.tar.gz\r\ncd check-hw\r\n./upgrade_script_1.23_testnet.sh\r\ncd ..\r\n```\r\n\r\n\r\nMake sure the upgrade script runs successfully. At the end you should see this message:\r\n```\r\nUpgrade script completed successfully\r\n```\r\n\r\n## 2. Download and install the new node\r\n```\r\nwget https://github.com/scrtlabs/SecretNetwork/releases/download/v1.23.0/secretnetwork_1.23.0_testnet_goleveldb_amd64_ubuntu-22.04.deb\r\nsudo apt install -y \"./ secretnetwork_1.23.0_testnet_goleveldb_amd64_ubuntu-22.04.deb\"\r\n```\r\n\r\n## 3. Start the new node\r\n```\r\n# re-apply any systemd unit file customizations\r\n\r\n# Restart the node\r\nsudo systemctl restart secret-node\r\njournalctl -fu secret-node\r\n```"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/249631398","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/249631398/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/249631398/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.22","id":249631398,"author":{"login":"valdok","id":9623498,"node_id":"MDQ6VXNlcjk2MjM0OTg=","avatar_url":"https://avatars.githubusercontent.com/u/9623498?v=4","gravatar_id":"","url":"https://api.github.com/users/valdok","html_url":"https://github.com/valdok","followers_url":"https://api.github.com/users/valdok/followers","following_url":"https://api.github.com/users/valdok/following{/other_user}","gists_url":"https://api.github.com/users/valdok/gists{/gist_id}","starred_url":"https://api.github.com/users/valdok/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/valdok/subscriptions","organizations_url":"https://api.github.com/users/valdok/orgs","repos_url":"https://api.github.com/users/valdok/repos","events_url":"https://api.github.com/users/valdok/events{/privacy}","received_events_url":"https://api.github.com/users/valdok/received_e