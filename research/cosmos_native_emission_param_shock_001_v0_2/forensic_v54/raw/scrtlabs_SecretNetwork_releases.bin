Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":38118128,"digest":null,"download_count":196,"created_at":"2022-10-17T11:01:17Z","updated_at":"2022-10-17T11:01:20Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-patch.3/secretnetwork_1.4.1-patch.3_mainnet_goleveldb_amd64.deb"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/81284018","id":81284018,"node_id":"RA_kwDODh_DHs4E2Euy","name":"secretnetwork_1.4.1-patch.3_mainnet_rocksdb_amd64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":42382240,"digest":null,"download_count":67,"created_at":"2022-10-17T11:01:17Z","updated_at":"2022-10-17T11:01:19Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-patch.3/secretnetwork_1.4.1-patch.3_mainnet_rocksdb_amd64.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.4.1-patch.3","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.4.1-patch.3","body":"# Dragonberry full patch\r\n\r\n## Patch instructions\r\n\r\n⚠️ If you want the upgrade to use iavl-fastnode (will improve performance) add `iavl-disable-fastnode = false` in `app.toml` under `[base]` before re-starting the node (it'll take several hours if you don't resync the node).\r\n\r\n⚠️ If you have already installed a previous 1.4.1 version be sure to set `iavl-disable-fastnode = false` or you will apphash\r\n\r\nNote: if you have modified your systemd unit file (`/etc/systemd/system/secret-node.service`) you will need to re-apply those changes post installation and pre-service restart.\r\n\r\nCheck what database type you're currently using:\r\n\r\n```bash\r\nawk -F \\\" '/^db_backend =/{print $2}' ~/.secretd/config/config.toml\r\n```\r\n\r\nUncomment and download the right binary based on your database type:\r\n\r\n```bash\r\n# Stop node\r\nsudo systemctl stop secret-node\r\n\r\n# Get & verify secretd v1.4.1-patch.3\r\n\r\n## goleveldb\r\n# wget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-patch.3/secretnetwork_1.4.1-patch.3_mainnet_goleveldb_amd64.deb\"\r\n# echo \"e31e3738c1bd9c5a822cefbb892320ca07ada88afb028aaa27b738fe1a15e13f secretnetwork_1.4.1-patch.3_mainnet_goleveldb_amd64.deb\" | sha256sum --check\r\n\r\n## rocksdb\r\n# wget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-patch.3/secretnetwork_1.4.1-patch.3_mainnet_rocksdb_amd64.deb\"\r\n# echo \"462c04d3f7d069ed5f5ab2c143c3d532d41ad485431c4ff3f6c0da360479e94d secretnetwork_1.4.1-patch.3_mainnet_rocksdb_amd64.deb\" | sha256sum --check\r\n\r\n# Install new binaries\r\nsudo apt install -y ./secretnetwork_1.4.1-patch.3_mainnet_*_amd64.deb\r\n\r\n# re-apply any systemd unit file customizations\r\n\r\n# Restart the node\r\nsudo systemctl restart secret-node\r\n```\r\n"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/80016939","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/80016939/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/80016939/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.4.1-patch.2","id":80016939,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"n