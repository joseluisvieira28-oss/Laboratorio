:"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":50701312,"digest":null,"download_count":10,"created_at":"2022-09-11T12:16:07Z","updated_at":"2022-09-11T12:16:42Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-beta.3/secretcli-Windows"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/77522889","id":77522889,"node_id":"RA_kwDODh_DHs4EnufJ","name":"secretnetwork_1.4.1-beta.3_testnet_goleveldb_amd64.deb","label":null,"uploader":{"login":"assafmo","id":22766533,"node_id":"MDQ6VXNlcjIyNzY2NTMz","avatar_url":"https://avatars.githubusercontent.com/u/22766533?v=4","gravatar_id":"","url":"https://api.github.com/users/assafmo","html_url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.github.com/users/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/assafmo/subscriptions","organizations_url":"https://api.github.com/users/assafmo/orgs","repos_url":"https://api.github.com/users/assafmo/repos","events_url":"https://api.github.com/users/assafmo/events{/privacy}","received_events_url":"https://api.github.com/users/assafmo/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/vnd.debian.binary-package","state":"uploaded","size":37873460,"digest":null,"download_count":14,"created_at":"2022-09-11T12:15:06Z","updated_at":"2022-09-11T12:15:31Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-beta.3/secretnetwork_1.4.1-beta.3_testnet_goleveldb_amd64.deb"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/77522878","id":77522878,"node_id":"RA_kwDODh_DHs4Enue-","name":"secretnetwork_1.4.1-beta.3_testnet_rocksdb_amd64.deb","label":null,"uploader":{"login":"assafmo","id":22766533,"node_id":"MDQ6VXNlcjIyNzY2NTMz","avatar_url":"https://avatars.githubusercontent.com/u/22766533?v=4","gravatar_id":"","url":"https://api.github.com/users/assafmo","html_url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.github.com/users/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/assafmo/subscriptions","organizations_url":"https://api.github.com/users/assafmo/orgs","repos_url":"https://api.github.com/users/assafmo/repos","events_url":"https://api.github.com/users/assafmo/events{/privacy}","received_events_url":"https://api.github.com/users/assafmo/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/vnd.debian.binary-package","state":"uploaded","size":41979188,"digest":null,"download_count":9,"created_at":"2022-09-11T12:14:36Z","updated_at":"2022-09-11T12:15:06Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-beta.3/secretnetwork_1.4.1-beta.3_testnet_rocksdb_amd64.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.4.1-beta.3","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.4.1-beta.3","body":"# :warning: TESTNET :warning:\r\n\r\n## Upgrading from v1.4.0-beta.6\r\n\r\nCheck what database type you're currently using:\r\n\r\n```bash\r\nawk -F \\\" '/^db_backend =/{print $2}' ~/.secretd/config/config.toml\r\n```\r\n\r\nUncomment and download the right binary based on your database type:\r\n\r\n```bash\r\n# Stop the v1.4.0 node\r\nsudo systemctl stop secret-node\r\n\r\n# Get & verify secretd v1.4.1\r\n\r\n## goleveldb\r\n# wget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-beta.3/secretnetwork_1.4.1-beta.3_testnet_goleveldb_amd64.deb\"\r\n# echo \"1ec2b9b197196113f34ec3430603972e472b35f91db0e6b98d2f772f8e0081d6 secretnetwork_1.4.1-beta.3_testnet_goleveldb_amd64.deb\" | sha256sum --check\r\n\r\n## rocksdb\r\n# wget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.4.1-beta.3/secretnetwork_1.4.1-beta.3_testnet_rocksdb_amd64.deb\"\r\n# echo \"f8aeb3f24448f244e36f4a1fb5f7f64ccc04c1796cac0e76f38aa6362c0b3017 secretnetwork_1.4.1-beta.3_testnet_rocksdb_amd64.deb\" | sha256sum --check\r\n\r\n# Install v1.4.1 binaries\r\nsudo apt install -y ./secretnetwork_1.4.1-beta.3_testnet_*_amd64.deb\r\n\r\n# Restart the node\r\nsudo systemctl restart secret-node\r\n```\r\n\r\nNote: Upgrading can take 2-3 hours, but afterwards node performance should drastically improve compared to v1.4.0.\r\n\r\n## What's Changed\r\n\r\n- Upgrade Cosmos SDK to v0.45.8\r\n- Upgrade Tendermint to v0.34.21\r\n\r\n**Full Changelog**: https://github.com/scrtlabs/SecretNetwork/compare/v1.4.0-beta.6...v1.4.1-beta.3\r\n"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/76826743","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/76826743/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/76826743/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.4.0-beta.6","id":76826743,"author":{"login":"assafmo","id":22766533,"node_id":"MDQ6VXNlcjIyNzY2NTMz","avatar_url":"https://avatars.githubusercontent.com/u/22766533?v=4","gravatar_id":"","url":"https://api.github.com/users/assafmo","html_url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.github.com/users/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/