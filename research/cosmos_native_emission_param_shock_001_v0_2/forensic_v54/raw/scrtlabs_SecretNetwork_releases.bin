s/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/assafmo/subscriptions","organizations_url":"https://api.github.com/users/assafmo/orgs","repos_url":"https://api.github.com/users/assafmo/repos","events_url":"https://api.github.com/users/assafmo/events{/privacy}","received_events_url":"https://api.github.com/users/assafmo/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/vnd.debian.binary-package","state":"uploaded","size":39577748,"digest":null,"download_count":164,"created_at":"2023-02-02T12:32:52Z","updated_at":"2023-02-02T12:32:56Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.6.1/secretnetwork_1.6.1_mainnet_goleveldb_amd64.deb"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/assets/94027722","id":94027722,"node_id":"RA_kwDODh_DHs4Fmr_K","name":"secretnetwork_1.6.1_mainnet_rocksdb_amd64.deb","label":null,"uploader":{"login":"assafmo","id":22766533,"node_id":"MDQ6VXNlcjIyNzY2NTMz","avatar_url":"https://avatars.githubusercontent.com/u/22766533?v=4","gravatar_id":"","url":"https://api.github.com/users/assafmo","html_url":"https://github.com/assafmo","followers_url":"https://api.github.com/users/assafmo/followers","following_url":"https://api.github.com/users/assafmo/following{/other_user}","gists_url":"https://api.github.com/users/assafmo/gists{/gist_id}","starred_url":"https://api.github.com/users/assafmo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/assafmo/subscriptions","organizations_url":"https://api.github.com/users/assafmo/orgs","repos_url":"https://api.github.com/users/assafmo/repos","events_url":"https://api.github.com/users/assafmo/events{/privacy}","received_events_url":"https://api.github.com/users/assafmo/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/vnd.debian.binary-package","state":"uploaded","size":43655396,"digest":null,"download_count":29,"created_at":"2023-02-02T12:32:47Z","updated_at":"2023-02-02T12:32:52Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.6.1/secretnetwork_1.6.1_mainnet_rocksdb_amd64.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.6.1","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.6.1","body":"## Updating from v1.6.0\r\n\r\n:warning: Note: The below instructions assume default installation. DO NOT COPY-PASTE if `config.toml` is not in `~/.secretd/config/config.toml` or if you modified `/etc/systemd/system/secret-node.service`.\r\n\r\n```bash\r\n# Stop the v1.6.0 node\r\nsudo systemctl stop secret-node\r\n\r\n# Figure out currently used db backend\r\nDB_BACKEND=$(awk -F \\\" '/^db_backend =/{print $2}' ~/.secretd/config/config.toml)\r\n\r\n# Get the v1.6.1 binaries\r\nwget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.6.1/secretnetwork_1.6.1_mainnet_${DB_BACKEND}_amd64.deb\"\r\n\r\n# Verify the v1.6.1 binaries\r\necho '2c043fb25f2b4f97eeda52a4033aff0ceb86f5dbb4738791f00eacdb8e065dfe secretnetwork_1.6.1_mainnet_goleveldb_amd64.deb\r\n384125518cb4255fc4c6fb31506f605f5d0b5685eec840942960be19d2944c30 secretnetwork_1.6.1_mainnet_rocksdb_amd64.deb' |\r\n    grep \"$DB_BACKEND\" |\r\n    sha256sum --check\r\n\r\n# Install the v1.6.1 binaries\r\nsudo apt install -y \"./secretnetwork_1.6.1_mainnet_${DB_BACKEND}_amd64.deb\"\r\n\r\n# Restart the node\r\nsudo systemctl restart secret-node\r\n```\r\n\r\n## What's Changed\r\n\r\n- Update Cosmos SDK to v0.45.12\r\n- Update Tendermint to v0.34.24\r\n\r\n**Full Changelog**: https://github.com/scrtlabs/SecretNetwork/compare/v1.6.0...v1.6.1"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/90722922","assets_url":"https://api.github.com/re