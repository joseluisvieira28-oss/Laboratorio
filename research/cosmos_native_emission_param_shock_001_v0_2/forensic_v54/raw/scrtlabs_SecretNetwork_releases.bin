s_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":61161028,"digest":null,"download_count":32,"created_at":"2024-11-14T10:55:35Z","updated_at":"2024-11-14T10:55:36Z","browser_download_url":"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.15.0-beta.15/secretnetwork_1.15.0-beta.15_testnet_goleveldb_amd64_ubuntu-22.04.deb"}],"tarball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/tarball/v1.15.0-beta.15","zipball_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/zipball/v1.15.0-beta.15","body":"# :warning: TESTNET :warning:\r\n\r\n### What's changed\r\n\r\n- Update ibc-go to v8.5.2\r\n- Update packet-forward-middleware to v8.0.2\r\n- Remove redundant fields from `compute` and `registration` protobufs \r\n\r\n### Breaking Changes\r\n\r\n- SecretCLI - From the current release secretcli v1.15.0-beta.15 or later is required.\r\n- Secret.js - From the current release secret.js v1.15.0-beta.1 or later is required.\r\n- Keplr - From the current release keplr v0.12.156 or later is required. Update instructions [here](https://help.keplr.app/articles/updating-your-chrome-extension).\r\n\r\n## Upgrade instructions (Ubuntu-22.04)\r\n```bash\r\n# Backup any systemd unit file customizations\r\n\r\nwget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.15.0-beta.15/secretnetwork_1.15.0-beta.15_testnet_goleveldb_amd64_ubuntu-22.04.deb\"\r\n\r\nsudo systemctl stop secret-node\r\n\r\nsudo apt install -y \"./secretnetwork_1.15.0-beta.15_testnet_goleveldb_amd64_ubuntu-22.04.deb\"\r\n\r\n# re-apply any systemd unit file customizations\r\n\r\n# Restart the node\r\nsudo systemctl restart secret-node\r\n```\r\n\r\n## Upgrade instructions (Ubuntu-20.04)\r\n```bash\r\n# Backup any systemd unit file customizations\r\n\r\nwget \"https://github.com/scrtlabs/SecretNetwork/releases/download/v1.15.0-beta.15/secretnetwork_1.15.0-beta.15_testnet_goleveldb_amd64_ubuntu-20.04.deb\"\r\n\r\nsudo systemctl stop secret-node\r\n\r\nsudo apt install -y \"./secretnetwork_1.15.0-beta.15_testnet_goleveldb_amd64_ubuntu-20.04.deb\"\r\n\r\n# re-apply any systemd unit file customizations\r\n\r\n# Restart the node\r\nsudo systemctl restart secret-node\r\n```\r\n\r\n**Full Changelog**: https://github.com/scrtlabs/SecretNetwork/compare/v1.15.0-beta.14...v1.15.0-beta.15"},{"url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/184146937","assets_url":"https://api.github.com/repos/scrtlabs/SecretNetwork/releases/184146937/assets","upload_url":"https://uploads.github.com/repos/scrtlabs/SecretNetwork/releases/184146937/assets{?name,label}","html_url":"https://github.com/scrtlabs/SecretNetwork/releases/tag/v1.15.0-alpha.15","id":184146937,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptio