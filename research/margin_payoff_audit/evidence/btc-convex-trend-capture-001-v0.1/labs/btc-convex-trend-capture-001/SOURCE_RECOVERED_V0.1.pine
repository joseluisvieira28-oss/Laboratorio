//@version=6
strategy("Quant Trailing v5 (Payoff Invertido) - BTC", overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=95,
         commission_type=strategy.commission.percent,
         commission_value=0.1,
         margin_long=0)

// ===== PARÂMETROS =====
zEntrada    = input.float(-2.0, "Z-Score de entrada (desvios)")
lookback    = input.int(20,   "Janela estatística")
stopInicial = input.float(4.0,  "Stop inicial %")    / 100
trailPerc   = input.float(12.0, "Trailing stop %")   / 100
ativaTrail  = input.float(5.0,  "Ativa trailing após lucro %") / 100
mmRegime    = input.int(200,  "Filtro de regime (MM200)")

// ===== 1. SINAIS DE ENTRADA =====
media   = ta.sma(close, lookback)
desvio  = ta.stdev(close, lookback)
zScore  = (close - media) / desvio

rsi      = ta.rsi(close, 14)
sinalRSI = rsi < 30 ? 1 : 0
sinalZ   = zScore < zEntrada ? 1 : 0
sinalBB  = close < ta.sma(close,20) - 2*ta.stdev(close,20) ? 1 : 0
sinalVol = volume > ta.sma(volume,20) ? 1 : 0

score    = sinalRSI + sinalZ + sinalBB + sinalVol

// ===== 2. FILTRO DE REGIME =====
mm200    = ta.sma(close, mmRegime)
regimeOK = close > mm200

// ===== 3. ENTRADA =====
entrar = score >= 3 and regimeOK

if entrar and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

// ===== 4. SAÍDA INVERTIDA =====
var float precoPico = na

if strategy.position_size > 0
    precoPico := na(precoPico) ? high : math.max(precoPico, high)
    lucroAtual = (close - strategy.position_avg_price) / strategy.position_avg_price
    precoStopIni = strategy.position_avg_price * (1 - stopInicial)
    precoTrail = precoPico * (1 - trailPerc)
    stopFinal = lucroAtual >= ativaTrail ? math.max(precoTrail, precoStopIni) : precoStopIni
    strategy.exit("Saída", "Long", stop=stopFinal)
else
    precoPico := na

// ===== VISUAL =====
plot(mm200, "Regime MM200", color=color.orange, linewidth=2)
plot(strategy.position_size > 0 ? precoPico : na, "Pico", color=color.lime, style=plot.style_cross)
bgcolor(regimeOK ? color.new(color.green,90) : color.new(color.red,90))
