{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crypto Lab V2 Result Receipt",
  "type": "object",
  "required": [
    "schema_version","family_id","stage","preoutcome_gate_commit","direction",
    "hurdle_h","hurdle_units","estimate","ci_lower","ci_upper","alpha_effective",
    "declared_status"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "family_id": {"type": "string", "minLength": 3},
    "stage": {"const": "POST_DEVELOPMENT"},
    "preoutcome_gate_commit": {"type": "string", "minLength": 7},
    "direction": {"enum": ["POSITIVE","NEGATIVE","TWO_SIDED"]},
    "hurdle_h": {"type": "number", "exclusiveMinimum": 0},
    "hurdle_units": {"type": "string", "minLength": 1},
    "estimate": {"type": "number"},
    "ci_lower": {"type": "number"},
    "ci_upper": {"type": "number"},
    "alpha_effective": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.2},
    "execution_status": {"enum": ["NOT_EVALUATED","ACCESSIBLE","EXECUTION_BLOCKED","INACCESSIBLE"]},
    "declared_status": {
      "enum": ["SURVIVES","NO_EDGE_AT_H","NO_EFFECT_OF_MAGNITUDE_H","INCONCLUSIVE"]
    }
  }
}
