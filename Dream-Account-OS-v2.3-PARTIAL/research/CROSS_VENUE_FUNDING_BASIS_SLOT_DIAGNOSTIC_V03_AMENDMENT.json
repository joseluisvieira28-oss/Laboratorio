  "permitted_outputs": [
    "timestamp counts",
    "scheduled-slot counts",
    "missing-slot counts",
    "collision counts",
    "timestamp-to-slot offsets",
    "complete full UTC months",
    "common complete full UTC months",
    "timestamp-only SHA256 fingerprints"
  ],
  "forbidden_outputs": [
    "funding-rate summaries",
    "carry",
    "APR/APY",
    "PnL",
    "Sharpe/Sortino",
    "signals",
