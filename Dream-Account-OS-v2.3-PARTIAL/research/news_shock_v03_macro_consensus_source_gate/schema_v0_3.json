{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "NEWS_SHOCK_LAB_V0_3_MACRO_SOURCE_EVENT",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_family", "reference_period", "scheduled_release_local", "release_timezone", "scheduled_release_utc", "cutoff_utc", "observations", "evidence", "status"],
  "properties": {
    "event_id": {"pattern": "^US_(CPI|NFP)_202[1-4]-[0-9]{2}-[0-9]{2}$", "type": "string"},
    "event_family": {"enum": ["CPI", "EMPLOYMENT_SITUATION"]},
    "reference_period": {"pattern": "^202[0-4]-[0-9]{2}$", "type": "string"},
    "scheduled_release_local": {"type": "string"},
    "release_timezone": {"const": "America/New_York"},
    "scheduled_release_utc": {"format": "date-time", "type": "string"},
    "actual_publication_utc": {"format": "date-time", "type": ["string", "null"]},
    "cutoff_utc": {"format": "date-time", "type": "string"},
    "observations": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "status": {"enum": ["COMPLETE_SINGLE_SOURCE", "COMPLETE_MIXED_SOURCE", "CONSENSUS_PROVENANCE_INCOMPLETE", "ACTUAL_PROVENANCE_INCOMPLETE", "PUBLICATION_TIME_UNRESOLVED", "SOURCE_CONFLICT", "SOURCE_VERSION_DRIFT_BLOCKED", "OUT_OF_SCOPE_BLOCKED"]}
  }
}
