    ],
    "event": "TokenExchange(address indexed buyer,int128 sold_id,uint256 tokens_sold,int128 bought_id,uint256 tokens_bought)"
  },
  "source_formula": {
    "sold_norm": "tokens_sold / 10^decimals[sold_id]",
    "bought_norm": "tokens_bought / 10^decimals[bought_id]",
    "nominal_notional": "(sold_norm + bought_norm) / 2",
    "abs_log_deviation": "abs(ln(bought_norm / sold_norm))",
    "daily_stress": "sum(nominal_notional * abs_log_deviation) / sum(nominal_notional) over UTC day"
  },
  "signal": {
    "discovery_start": "2021-01-01",
    "discovery_end": "2024-12-31",
    "threshold": "80th percentile of previous 90 complete UTC daily STRESS observations, excluding current day",
    "position": "SHORT ETH if STRESS_t > threshold_t; otherwise NO_TRADE",
    "expected_relation": "negative",
    "entry": "next UTC day 00:00",
    "exit": "following UTC day 00:00",
    "base_cost_bps": 10,
    "stress_cost_bps": 20
  },
  "source_gate": {
    "primary_rpc": "https://public.1rpc.io/eth",
