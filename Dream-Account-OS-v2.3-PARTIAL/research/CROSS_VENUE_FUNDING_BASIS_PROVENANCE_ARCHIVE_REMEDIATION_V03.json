    "missing_archive_policy": "FAIL_CLOSED_NO_BACKFILL",
    "schema_drift_policy": "FAIL_CLOSED"
  },
  "allowed_outputs": [
    "archive_url",
    "checksum_url",
    "checksum_expected",
